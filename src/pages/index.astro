---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Video from '../components/Video.astro';
import TeSuena from '../components/TeSuena.astro';
import Metodo from '../components/Metodo.astro';
import ComoTrabajo from '../components/ComoTrabajo.astro';
import Testimonios from '../components/Testimonios.astro';
import SobreMi from '../components/SobreMi.astro';
import Faq from '../components/Faq.astro';
import Reto from '../components/Reto.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Intro />
  <Header />
  <main id="main">
    <Hero />
    <Video />
    <Marquee />
    <TeSuena />
    <Metodo />
    <ComoTrabajo />
    <Testimonios />
    <SobreMi />
    <Faq />
    <Reto />
  </main>
  <Footer />
</Base>
