---
import '../styles/global.css';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Datos estructurados: tipo de negocio y zona de servicio
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/femuix-logo.svg'), Astro.site).href,
  email: site.email,
  areaServed: { '@type': 'City', name: 'Barcelona' },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="light dark" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Siempre abre en modo día; el modo noche solo dura mientras se navega por la web (sesión)
        var theme = 'light';
        try {
          if (sessionStorage.getItem('femuix-theme') === 'dark') theme = 'dark';
        } catch (e) {}
        d.dataset.theme = theme;
        // La barra del navegador móvil sigue el color de la cabecera
        if (theme === 'dark') document.querySelector('meta[name="theme-color"]').content = '#000000';
        // La intro con el isotipo solo se ve una vez por sesión
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && !sessionStorage.getItem('femuix-intro')) {
            d.classList.add('intro');
            sessionStorage.setItem('femuix-intro', '1');
            history.scrollRestoration = 'manual';
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />

    <script>
      import '../scripts/motion';
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 16px;
        top: -64px;
        z-index: 200;
        padding: 10px 16px;
        background: var(--green);
        color: var(--white);
        border-radius: var(--radius);
        text-decoration: none;
        font-size: 0.875rem;
      }
      .skip-link:focus {
        top: 16px;
      }
      /* El aro del foco global es verde y el enlace también: aro blanco hacia dentro */
      .skip-link:focus-visible {
        outline: 2px solid var(--white);
        outline-offset: -5px;
      }
    </style>
  </body>
</html>
