---
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { dolores } from '../data/site';

// Frase que se "enciende" palabra a palabra con el scroll
const frase = [
  { text: 'Si has dicho que sí a alguna, no es falta de gusto.' },
  { text: 'Es falta de orden.', em: true },
];
const palabras = frase.flatMap((p) => p.text.split(' ').map((w) => ({ w, em: p.em })));
---

<section class="section suena" aria-labelledby="suena-title">
  <div class="container">
    <div class="suena__head">
      <span class="eyebrow reveal">Seamos sinceros</span>
      <SplitText id="suena-title" class="h-section" parts={[{ text: '¿Te' }, { text: 'suena?', em: true }]} />
    </div>

    <ol class="suena__list">
      {
        dolores.map((d, i) => (
          <li class="reveal" data-check>
            <span class="suena__n">0{i + 1}</span>
            <span class="suena__text">{d}</span>
            <span class="suena__icon">
              <Icon name="check" />
            </span>
          </li>
        ))
      }
    </ol>

    <p class="fill" data-fill>
      <span class="visually-hidden">{frase.map((p) => p.text).join(' ')}</span>
      {
        palabras.map((p, i) => (
          <>
            <span class:list={['fw', { 'fw--em': p.em }]} aria-hidden="true">
              {p.w}
            </span>
            {i < palabras.length - 1 && ' '}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .suena__head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .suena__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .suena__list li {
    position: relative;
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: clamp(24px, 3vw, 40px) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  /* Al leer cada frase (cuando cruza el centro de la pantalla) se marca como «me suena»:
     se dibuja el filete, el texto avanza y el círculo se rellena con el check */
  .suena__list li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-move) var(--ease);
  }

  .suena__list li.is-on::after {
    transform: scaleX(1);
  }

  .suena__n {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.125rem;
    color: var(--number);
  }

  /* El padding derecho reserva lo que avanza el texto al marcarse (12 px): con la frase ya marcada
     quedan los 24 px del gap hasta el check, aunque la línea llene todo el ancho */
  .suena__text {
    padding-right: 12px;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2.4vw, 2.1rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.015em;
    transition: transform var(--t-move) var(--ease);
  }

  .suena__list li.is-on .suena__text {
    transform: translateX(12px);
  }

  .suena__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease),
      border-color var(--t-color) var(--ease);
  }

  :global(.js) .suena__icon :global(svg) {
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform var(--t-move) var(--ease) 0.15s,
      opacity var(--t-color) var(--ease) 0.15s;
  }

  .suena__list li.is-on .suena__icon :global(svg) {
    transform: none;
    opacity: 1;
  }

  .suena__list li.is-on .suena__icon {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .suena__icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .fill {
    max-width: 18em;
    margin-top: clamp(80px, 11vw, 160px);
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5.4vw, 5rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* Antes de encenderse ya cumple 3:1 (texto grande, WCAG 1.4.3) */
  .fw {
    color: var(--fill-dim);
    transition: color var(--t-color) var(--ease);
  }

  .fw.is-lit {
    color: var(--text);
  }

  .fw--em {
    font-style: italic;
  }

  .fw--em.is-lit {
    color: var(--em);
  }

  @media (max-width: 640px) {
    .suena__list li {
      grid-template-columns: 40px 1fr;
      align-items: start;
    }
    .suena__icon {
      display: none;
    }
    .suena__text {
      padding-right: 0; /* sin check al lado, no hay hueco que reservar */
    }
  }
</style>
