---
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import Placeholder from './Placeholder.astro';
import SplitText from './SplitText.astro';
import CtaReforma from './CtaReforma.astro';
import { site, sobreMi } from '../data/site';
import { retrato } from '../data/media';
---

<section class="section band tex-none sobre" id="sobre-mi" data-expand aria-labelledby="sobre-title">
  <div class="container sobre__grid">
    <!-- Rótulo y titular: en móvil, por encima de la foto; en escritorio, en la columna del texto -->
    <div class="sobre__head">
      <span class="eyebrow reveal">Antes de nada</span>
      <SplitText
        id="sobre-title"
        class="h-section"
        parts={[{ text: 'Quién soy y' }, { text: 'por qué trabajo así.', em: true, br: true }]}
      />
    </div>

    <!-- Retrato con la firma superpuesta, como una tarjeta de visita -->
    <div class="sobre__media" data-stagger-scope>
      <div class="sobre__frame">
        <div class="clip-reveal" data-first data-step="1700">
          <div data-parallax="0.08">
            <Placeholder
              label="Foto tuya"
              note="Mirando a cámara, en una obra o en tu mesa de trabajo."
              ratio="4 / 5"
              foto={retrato}
              sizes="(max-width: 640px) 100vw, 40vw"
            />
          </div>
        </div>
      </div>

      <p class="sobre__sign">
        <Isotipo class="sobre__mark" />
        <span class="sobre__sign-text">
          <span class="sobre__name">Andrea</span>
          <span class="sobre__role">Interiorista en {site.city}</span>
        </span>
      </p>
    </div>

    <div class="sobre__copy">

      <blockquote class="sobre__quote reveal" data-step="600">
        <p>{sobreMi.cita}</p>
      </blockquote>

      <ol class="sobre__pacts">
        {
          sobreMi.compromisos.map((c, i) => (
            <li class="reveal" data-step="170">
              <span class="sobre__n"><span>0{i + 1}</span></span>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </li>
          ))
        }
      </ol>

      <div class="sobre__actions reveal">
        <CtaReforma />
        <a class="more-link" href="#metodo">
          <span>Ver el método, fase a fase</span>
          <span class="more-link__icon" aria-hidden="true"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Columnas iguales: el retrato gana tamaño y equilibra la altura del texto */
  /* La foto ocupa la columna izquierda entera; a la derecha, titular y texto juntos y centrados
     en vertical respecto a ella (las filas 1fr de arriba y abajo se llevan el espacio sobrante) */
  .sobre__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto 1fr;
    column-gap: clamp(48px, 8vw, 128px);
    row-gap: 0;
  }

  .sobre__media {
    grid-column: 1;
    grid-row: 1 / -1;
    align-self: center;
  }

  .sobre__head {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    gap: 28px;
    justify-items: start;
    margin-bottom: 28px;
  }

  .sobre__copy {
    grid-column: 2;
    grid-row: 3;
  }

  /* ---------- Retrato ---------- */

  .sobre__media {
    position: relative;
    padding-bottom: 48px;
  }

  /* Paspartú blanco alrededor de la foto */
  .sobre__frame {
    padding: clamp(10px, 1.2vw, 16px);
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--surface);
    box-shadow: 0 40px 80px -48px rgba(14, 32, 27, 0.55);
  }

  .sobre__frame .clip-reveal {
    overflow: hidden;
    border-radius: var(--radius-lg);
  }

  /* El retrato ya viene en monocolor verde pino (#1D3C34): sin el filtro que apaga las fotos,
     para que el verde sea exacto. En Dark UI pasa a grafito, sin verde */
  .sobre__frame :global(.ph__img) {
    filter: none;
  }

  :global([data-theme='dark']) .sobre__frame :global(.ph__img) {
    filter: grayscale(1);
  }

  /* --base suma un retardo fijo al orden de aparición que calcula motion.ts. La foto arranca justo
     tras el paspartú y se descubre en 1,2 s (la imagen se aleja en 1,6 s) */
  :global(.js) .sobre__frame :global(.clip-reveal) {
    --base: 150ms;
    transition-duration: 1.2s;
  }

  :global(.js) .sobre__frame :global(.clip-reveal > *) {
    transition-duration: 1.6s;
  }

  /* Tarjeta de firma que se apoya sobre la esquina de la foto */
  .sobre__sign {
    position: absolute;
    right: clamp(-40px, -3vw, -16px);
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 26px 18px 20px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 24px 48px -28px rgba(14, 32, 27, 0.5);
  }

  .sobre__sign :global(.sobre__mark) {
    flex-shrink: 0;
    width: 40px;
  }

  .sobre__sign-text {
    display: grid;
    gap: 4px;
  }

  .sobre__name {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
    color: var(--text);
  }

  .sobre__role {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- Texto ---------- */

  .sobre__copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }


  /* Cita: la idea que guía el estudio */
  /* El filete dorado es un borde de un pseudoelemento para poder dibujarlo al entrar; al ser borde,
     se sigue viendo con los colores forzados de Windows */
  .sobre__quote {
    position: relative;
    margin: 4px 0 0;
    padding: 2px 0 2px 18px;
  }

  .sobre__quote::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-left: 2px solid var(--gold-line);
    transform-origin: top;
  }

  .sobre__quote p {
    text-wrap: balance;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--em);
  }

  /* Compromisos: lista editorial con filetes finos, como el resto de listas de la web */
  .sobre__pacts {
    width: 100%;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .sobre__pacts li {
    position: relative;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    align-items: baseline;
    row-gap: 4px;
    padding: 20px 0 22px;
  }

  /* Filete inferior: se dibuja de izquierda a derecha al entrar cada compromiso */
  .sobre__pacts li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-bottom: 1px solid var(--line-strong);
    transform-origin: left;
  }

  /* El número sube desde su línea base: se recorta solo por debajo */
  .sobre__n {
    grid-row: span 2;
    clip-path: inset(-50% -50% 0 -50%);
    font-family: var(--serif);
    font-size: 1.625rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--number);
  }

  .sobre__n > span {
    display: inline-block;
  }

  .sobre__pacts h3 {
    font-size: clamp(1.1875rem, 1.6vw, 1.375rem);
    line-height: 1.25;
  }

  .sobre__pacts p {
    grid-column: 2;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Acciones: el botón principal y el enlace secundario editorial; el último filete de los
     compromisos ya las separa del texto */
  .sobre__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    width: 100%;
    margin-top: 12px;
  }

  /* ---------- Entrada ----------
     Todo sale en orden de lectura, y cada paso espera al anterior (S = momento en que entra la foto):
     1. S+0: el paspartú sube y se asienta; dentro, la foto se descubre de abajo arriba mientras se aleja.
     2. S+1,1 s: con la foto casi entera llega la tarjeta de la firma y, tras ella, su rombo, el nombre
        y el cargo, uno detrás de otro.
     3. S+1,7 s (data-step de la foto): a la derecha, en orden: rótulo, titular, entradilla. El filete
        dorado de la cita se dibuja de arriba abajo y la frase aparece de izquierda a derecha, como
        si se escribiera; los compromisos esperan a que la frase esté casi escrita (data-step de la
        cita) y suben uno tras otro, cada uno con su número, su título y su texto escalonados; el
        filete de cada compromiso se dibuja mientras llega su texto.
     --stagger (motion.ts) marca cuándo empieza cada bloque; lo de dentro se apoya en él.
     data-first (motion.ts) hace que la foto salga siempre la primera: el texto es más alto que ella
     y su rótulo cruzaría la línea de entrada antes. data-step es lo que hace esperar a lo siguiente:
     la foto tarda más en descubrirse que un texto en aparecer, y sin él el texto saldría antes.
     Si el sistema pide reducir el movimiento no se aplica nada de esto: todo está quieto y a la vista. */
  @media (prefers-reduced-motion: no-preference) {
    /* Foto y firma dependen de :has() para saber cuándo se ha descubierto la foto. Sin :has()
       (navegadores antiguos) no se oculta nada: la regla que lo muestra no existiría y la foto
       se quedaría invisible. */
    @supports selector(:has(*)) {
      /* --stagger llega de la foto (data-stagger-scope): el paspartú sube justo antes de que se descubra */
      :global(.js) .sobre__frame {
        opacity: 0;
        translate: 0 40px;
        scale: 0.97;
        transition:
          opacity var(--t-enter) var(--ease) var(--stagger, 0ms),
          translate var(--t-media) var(--ease) var(--stagger, 0ms),
          scale var(--t-media) var(--ease) var(--stagger, 0ms);
      }

      :global(.js) .sobre__frame:has(:global(.clip-reveal.is-visible)) {
        opacity: 1;
        translate: 0 0;
        scale: 1;
      }

      :global(.js) .sobre__sign {
        --wait: calc(var(--stagger, 0ms) + 1100ms);
        opacity: 0;
        translate: 40px 0;
        transition:
          opacity var(--t-enter) var(--ease) var(--wait),
          translate var(--t-enter) var(--ease) var(--wait);
      }

      :global(.js) .sobre__sign :global(.sobre__mark),
      :global(.js) .sobre__name,
      :global(.js) .sobre__role {
        opacity: 0;
        transition:
          opacity var(--t-enter) var(--ease) calc(var(--wait) + var(--in)),
          translate var(--t-enter) var(--ease) calc(var(--wait) + var(--in)),
          scale var(--t-enter) var(--ease) calc(var(--wait) + var(--in));
      }

      :global(.js) .sobre__sign :global(.sobre__mark) {
        --in: 160ms;
        scale: 0.6;
      }

      :global(.js) .sobre__name {
        --in: 270ms;
        translate: 0 10px;
      }

      :global(.js) .sobre__role {
        --in: 360ms;
        translate: 0 10px;
      }

      :global(.js) .sobre__media:has(:global(.clip-reveal.is-visible)) .sobre__sign,
      :global(.js) .sobre__media:has(:global(.clip-reveal.is-visible)) .sobre__sign :global(.sobre__mark),
      :global(.js) .sobre__media:has(:global(.clip-reveal.is-visible)) .sobre__name,
      :global(.js) .sobre__media:has(:global(.clip-reveal.is-visible)) .sobre__role {
        opacity: 1;
        translate: 0 0;
        scale: 1;
      }
    }

    /* Cita: el bloque no sube ni se difumina; se dibuja el filete y se escribe la frase */
    :global(.js) .sobre__quote.reveal {
      opacity: 1;
      transform: none;
      filter: none;
    }

    :global(.js) .sobre__quote::before {
      transform: scaleY(0);
      transition: transform var(--t-enter) var(--ease) var(--stagger, 0ms);
    }

    :global(.js) .sobre__quote p {
      -webkit-mask-image: linear-gradient(90deg, #000 33.3%, transparent 66.6%);
      mask-image: linear-gradient(90deg, #000 33.3%, transparent 66.6%);
      -webkit-mask-size: 300% 100%;
      mask-size: 300% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
      transition:
        -webkit-mask-position 1.3s var(--ease) calc(var(--stagger, 0ms) + 200ms),
        mask-position 1.3s var(--ease) calc(var(--stagger, 0ms) + 200ms);
    }

    :global(.js) .sobre__quote.is-visible::before {
      transform: none;
    }

    :global(.js) .sobre__quote.is-visible p {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }

    /* Compromisos: el filete se dibuja y, encima, número, título y texto llegan escalonados */
    :global(.js) .sobre__pacts li::after {
      transform: scaleX(0);
      transition: transform var(--t-media) var(--ease-in-out) var(--stagger, 0ms);
    }

    :global(.js) .sobre__pacts li:global(.is-visible)::after {
      transform: none;
    }

    :global(.js) .sobre__n > span,
    :global(.js) .sobre__pacts h3,
    :global(.js) .sobre__pacts p {
      transition:
        opacity var(--t-enter) var(--ease) calc(var(--stagger, 0ms) + var(--in)),
        translate var(--t-enter) var(--ease) calc(var(--stagger, 0ms) + var(--in));
    }

    :global(.js) .sobre__n > span {
      --in: 180ms;
      translate: 0 105%;
    }

    :global(.js) .sobre__pacts h3 {
      --in: 280ms;
      opacity: 0;
      translate: 0 12px;
    }

    :global(.js) .sobre__pacts p {
      --in: 380ms;
      opacity: 0;
      translate: 0 12px;
    }

    :global(.js) .sobre__pacts :global(.is-visible) .sobre__n > span,
    :global(.js) .sobre__pacts :global(.is-visible) h3,
    :global(.js) .sobre__pacts :global(.is-visible) p {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 900px) {
    .sobre__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(32px, 5vw, 48px);
    }
    .sobre__media {
      align-self: start;
    }
    .sobre__head {
      grid-row: 1;
    }
    .sobre__copy {
      grid-row: 2;
    }
    .sobre__sign {
      right: 12px;
    }
  }

  @media (max-width: 640px) {
    /* Una columna: titular, foto y texto, en ese orden */
    .sobre__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 40px;
    }
    .sobre__head,
    .sobre__media,
    .sobre__copy {
      grid-column: 1;
      grid-row: auto;
    }
    .sobre__head {
      margin-bottom: 0;
    }
    .sobre__media {
      max-width: 420px;
    }
    .sobre__sign {
      left: 12px;
      right: 12px;
      gap: 12px;
      padding: 14px 18px 14px 14px;
    }
    .sobre__sign :global(.sobre__mark) {
      width: 30px;
    }
    .sobre__name {
      font-size: 1.25rem;
    }
    .sobre__role {
      font-size: 0.625rem;
      letter-spacing: 0.12em;
    }
    .sobre__actions .more-link {
      margin-inline: auto;
    }
  }
</style>
