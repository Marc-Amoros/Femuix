---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { url } from '../data/site';

// En páginas interiores los enlaces apuntan a las secciones de la portada
interface Props {
  base?: string;
}

const { base = '' } = Astro.props;

const year = new Date().getFullYear();

const legal = [
  { label: 'Aviso legal', href: url('/aviso-legal') },
  { label: 'Privacidad', href: url('/privacidad') },
  { label: 'Cookies', href: url('/cookies') },
  { label: 'Accesibilidad', href: url('/accesibilidad') },
];
---

<footer class="footer on-dark" data-expand>
  <div class="container">
    <div class="footer__main reveal">
      <div class="footer__brand">
        <a href={`${base}#top`} class="footer__logo" aria-label="Femuix, volver arriba">
          <Logo tone="light" class="only-light" />
          <Logo tone="gray" class="only-dark" />
        </a>
        <p class="footer__tagline">
          Reformas de vivienda con orden: plan por fases, todo por escrito y una sola
          interlocutora.
        </p>
      </div>

      <a class="footer__top-link" href={`${base}#top`}>
        Volver arriba
        <span class="footer__top-icon" aria-hidden="true"><Icon name="arrow" /></span>
      </a>
    </div>

    <div class="footer__bottom reveal">
      <span>© {year} Femuix</span>
      <nav class="footer__legal" aria-label="Legal">
        {legal.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    --ft-link: var(--pine-100);
    --ft-soft: var(--pine-200);
    --ft-line: rgba(201, 217, 213, 0.18);
    --ft-dot: var(--warm);
    padding-top: clamp(64px, 8vw, 104px);
    font-size: 0.9375rem;
    /* Lo que aún no ha entrado (desplazado hacia abajo) no alarga la página más allá del pie */
    overflow: clip;
  }

  /* Dark UI: pie en grafito con la escala de grises de black 2 */
  :global([data-theme='dark']) .footer {
    --on-dark-muted: var(--g-200);
    --ft-link: #f5f5f5;
    --ft-soft: var(--g-200); /* 7,6:1 también sobre el brillo gris */
    --ft-line: rgba(131, 129, 130, 0.3);
    --ft-dot: var(--warm);
  }

  /* ---------- Marca ---------- */

  .footer__main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .footer__brand {
    display: grid;
    gap: 28px;
  }

  .footer__logo {
    display: block;
    width: clamp(180px, 18vw, 240px);
  }

  .footer__logo :global(svg) {
    width: 100%;
    height: auto;
  }

  .footer__tagline {
    max-width: 30em;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--white);
  }

  /* ---------- Barra final ---------- */

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 44px;
    padding: 20px 0 clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--ft-line);
    font-size: 0.8125rem;
    color: var(--ft-soft);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 44px;
  }

  .footer__legal a {
    padding-block: 10px; /* objetivo de 40 px de alto */
    color: var(--ft-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color var(--t-color) var(--ease);
  }

  .footer__legal a:hover {
    color: var(--white);
    text-decoration-color: var(--ft-dot);
  }

  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ft-link);
    text-decoration: none;
  }

  .footer__top-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--ft-line);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25); /* el mismo relleno suave que la píldora del email */
    transition:
      background-color var(--t-color) var(--ease),
      border-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  :global([data-theme='dark']) .footer__top-icon {
    background: rgba(255, 255, 255, 0.05);
  }

  .footer__top-icon :global(svg) {
    width: 16px;
    height: 16px;
    transform: rotate(-90deg);
    transition: transform var(--t-move) var(--ease);
  }

  .footer__top-link:hover .footer__top-icon,
  .footer__top-link:focus-visible .footer__top-icon {
    border-color: var(--white);
    background: var(--white);
    color: var(--green);
  }

  .footer__top-link:hover .footer__top-icon :global(svg),
  .footer__top-link:focus-visible .footer__top-icon :global(svg) {
    transform: rotate(-90deg) translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__top-icon :global(svg) {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .footer__main {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer__legal {
      gap: 0 24px;
    }
  }
</style>
