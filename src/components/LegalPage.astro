---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { url } from '../data/site';

// Plantilla de las páginas interiores (textos legales y accesibilidad)
interface Props {
  title: string;
  description: string;
  updated: string;
  draft?: boolean;
}

const { title, description, updated, draft = true } = Astro.props;
---

<Base title={`${title} · Femuix`} description={description}>
  <Header base={url('/')} />
  <main id="main" class="legal">
    <div class="container legal__inner">
      <a class="legal__back text-link" href={url('/')}>Volver a la portada</a>
      <h1 class="legal__title">{title}</h1>
      <p class="legal__meta">Última actualización: {updated}</p>
      {
        draft && (
          <p class="legal__draft" role="note">
            Borrador: los datos entre [corchetes] están pendientes y el texto debe revisarlo un
            profesional antes de publicar la web.
          </p>
        )
      }
      <div class="legal__body">
        <slot />
      </div>
    </div>
  </main>
  <Footer base={url('/')} />
</Base>

<style>
  .legal {
    padding: clamp(136px, 16vw, 200px) 0 var(--section);
  }

  .legal__inner {
    max-width: calc(760px + var(--gutter) * 2);
  }

  .legal__back {
    font-size: 0.875rem;
  }

  .legal__title {
    margin-top: 32px;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }

  .legal__meta {
    margin-top: 16px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .legal__draft {
    margin-top: 28px;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: #111111; /* fondo siempre claro (bruma o gris 427 C): 9,5:1 o más */
    font-size: 0.875rem;
  }

  .legal__body {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .legal__body :global(h2) {
    margin: 48px 0 16px;
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }

  .legal__body :global(p),
  .legal__body :global(li) {
    max-width: 68ch;
    line-height: 1.75;
  }

  .legal__body :global(p + p) {
    margin-top: 14px;
  }

  .legal__body :global(ul) {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding-left: 1.2em;
  }

  .legal__body :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 10px 24px;
    margin: 0;
  }

  .legal__body :global(dt) {
    font-weight: 500;
  }

  .legal__body :global(dd) {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .legal__body :global(dl) {
      grid-template-columns: 1fr;
      gap: 2px 0;
    }
    .legal__body :global(dd) {
      margin-bottom: 10px;
    }
  }
</style>
