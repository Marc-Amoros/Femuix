---
import SplitText from './SplitText.astro';
import { preguntas } from '../data/site';
---

<!-- Preguntas frecuentes con <details>: accesibles con teclado y lector de pantalla sin JavaScript -->
<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <span class="eyebrow reveal">Preguntas frecuentes</span>
      <SplitText
        id="faq-title"
        class="h-section"
        parts={[{ text: 'Lo que conviene saber' }, { text: 'antes de empezar', em: true }]}
      />
    </div>

    <!-- La primera pregunta sale abierta, como ejemplo de cómo se despliegan -->
    <div class="faq__list">
      {
        preguntas.map((p, i) => (
          <details class="faq__item reveal" open={i === 0}>
            <summary>
              <span class="faq__q">{p.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <path class="faq__v" d="M12 5v14" />
                  <path d="M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="faq__a">{p.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 28px;
  }

  /* Corte natural, sin equilibrar: «Lo que conviene / saber antes de / empezar» */
  .faq__head :global(.h-section) {
    text-wrap: wrap;
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color var(--t-color) var(--ease);
  }

  /* La pregunta abierta se marca con un filete dorado y la cursiva de la marca */
  .faq__item[open] {
    border-bottom-color: var(--gold-line);
  }

  .faq__item[open] .faq__q {
    color: var(--em-text);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 15px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: 6px;
  }

  .faq__q {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--text);
    transition: transform var(--t-move) var(--ease);
  }

  summary:focus-visible .faq__q,
  summary.is-tapped .faq__q {
    transform: translateX(8px);
  }

  @media (hover: hover) {
    summary:hover .faq__q {
      transform: translateX(8px);
    }
  }

  /* Abre y cierra con el mismo gesto: la respuesta se despliega y se recoge (donde el navegador
     sabe animar la altura de <details>; en el resto, solo aparece) */
  @supports (interpolate-size: allow-keywords) {
    .faq__item {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--t-move) var(--ease),
        content-visibility var(--t-move) allow-discrete;
    }
    .faq__item[open]::details-content {
      height: auto;
    }
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    color: var(--ink);
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .faq__icon svg {
    width: 13px;
    height: 13px;
  }

  /* Abierta: el círculo se rellena y el «+» pasa a «−» (el trazo vertical se recoge) */
  .faq__item[open] .faq__icon {
    background: var(--ink);
    color: var(--bg);
  }

  .faq__v {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform var(--t-move) var(--ease);
  }

  .faq__item[open] .faq__v {
    transform: scaleY(0);
  }

  .faq__a {
    max-width: 68ch;
    padding: 0 0 18px;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
    animation: faq-in 0.5s var(--ease);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__a {
      animation: none;
    }
    summary:hover .faq__q,
    summary:focus-visible .faq__q {
      transform: none;
    }
    .faq__item::details-content,
    .faq__v {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq__head {
      position: static;
    }
  }
</style>
