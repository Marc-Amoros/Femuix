---
import Icon from './Icon.astro';
import EmailPill from './EmailPill.astro';
import Isotipo from './Isotipo.astro';
import SplitText from './SplitText.astro';
import { preguntas, site } from '../data/site';
---

<!-- Preguntas frecuentes con <details>: accesibles con teclado y lector de pantalla sin JavaScript -->
<section class="section faq" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__head">
      <span class="eyebrow reveal">Preguntas frecuentes</span>
      <SplitText
        id="faq-title"
        class="h-section"
        parts={[{ text: 'Lo que conviene saber' }, { text: 'antes de empezar', em: true }]}
      />
    </div>

    <div class="faq__body">
      <div class="faq__list">
        {
          preguntas.map((p, i) => (
            <details class="faq__item reveal">
              <summary>
                <span class="faq__q">{p.q}</span>
                <span class="faq__icon" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </summary>
              <p class="faq__a">{p.a}</p>
            </details>
          ))
        }
      </div>

      <!-- Tarjeta de contacto: el email se puede abrir o copiar (por si no hay app de correo) -->
      <div class="ask reveal">
        <Isotipo class="ask__mark" />
        <div class="ask__body">
          <p class="ask__title">¿No encuentras tu pregunta?</p>
          <p class="ask__text">Escríbeme y te respondo yo, personalmente.</p>
          <EmailPill email={site.email} class="ask__pill" />
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .faq__head {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 28px;
  }

  /* ---------- Tarjeta «¿No encuentras tu pregunta?» ---------- */

  .faq__body {
    display: grid;
    gap: clamp(32px, 4vw, 48px);
  }

  .ask {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    margin-top: 8px;
    padding: clamp(24px, 2.4vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--tint);
  }

  /* Filete dorado arriba, como el de las cifras de la portada */
  .ask::before {
    content: '';
    position: absolute;
    top: 0;
    left: clamp(24px, 2.4vw, 32px);
    width: 48px;
    height: 2px;
    background: var(--gold-line);
  }

  /* En el móvil el símbolo va encima, para dejar todo el ancho al texto y al email */
  @media (max-width: 480px) {
    .ask {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .ask :global(.ask__mark) {
    width: 32px;
    margin-top: 4px;
  }

  .ask__body {
    display: grid;
    gap: 6px;
    min-width: 0;
  }

  .ask__title {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.5vw, 1.4rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--text);
  }

  .ask__text {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color var(--t-color) var(--ease);
  }

  /* La pregunta abierta se marca con un filete dorado y la cursiva de la marca */
  .faq__item[open] {
    border-bottom-color: var(--gold-line);
  }

  .faq__item[open] .faq__q {
    color: var(--em-text);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: 6px;
  }

  .faq__q {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 300;
    line-height: 1.35;
    color: var(--text);
    transition: transform var(--t-move) var(--ease);
  }

  summary:focus-visible .faq__q,
  summary.is-tapped .faq__q {
    transform: translateX(8px);
  }

  @media (hover: hover) {
    summary:hover .faq__q {
      transform: translateX(8px);
    }
  }

  /* Abre y cierra con el mismo gesto: la respuesta se despliega y se recoge (donde el navegador
     sabe animar la altura de <details>; en el resto, solo aparece) */
  @supports (interpolate-size: allow-keywords) {
    .faq__item {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--t-move) var(--ease),
        content-visibility var(--t-move) allow-discrete;
    }
    .faq__item[open]::details-content {
      height: auto;
    }
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    color: var(--ink);
    transition:
      transform var(--t-move) var(--ease),
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .faq__icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--bg);
  }

  .faq__a {
    max-width: 58ch;
    padding: 0 64px 28px 0;
    color: var(--muted);
    animation: faq-in 0.5s var(--ease);
  }

  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__a {
      animation: none;
    }
    summary:hover .faq__q,
    summary:focus-visible .faq__q {
      transform: none;
    }
    .faq__item::details-content {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .faq__head {
      position: static;
    }
    .faq__a {
      padding-right: 0;
    }
  }
</style>
