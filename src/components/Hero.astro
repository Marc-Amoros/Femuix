---
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import Placeholder from './Placeholder.astro';
import SplitText from './SplitText.astro';
import { llamada, site } from '../data/site';
import { fotos, usarMuestras } from '../data/media';

// `count` anima el número al entrar en pantalla
const datos = [
  { etiqueta: 'El método', valor: '4', count: 4, unidad: 'fases', texto: 'Cerradas y en orden: ninguna empieza sin cerrar la anterior.' },
  { etiqueta: 'El plazo', valor: '12–14', unidad: 'semanas', texto: 'De la primera visita a la entrega de llaves.' },
  { etiqueta: 'Las revisiones', valor: '2', count: 2, unidad: 'rondas', texto: 'De cambios en cada fase, incluidas en el precio.' },
];

const badge = 'Reto gratuito · Empieza aquí · Reto gratuito · Empieza aquí · ';

const confianza = ['Reto gratuito', 'Pagas fase a fase', 'Contrato antes de empezar'];
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow reveal">Reformas de vivienda · Barcelona</span>

      <SplitText
        as="h1"
        class="h-display"
        delay={100}
        parts={[
          { text: 'No descubras los errores de tu reforma' },
          { text: 'cuando ya no hay marcha atrás.', em: true },
        ]}
      />

      <p class="lead reveal" style="--delay: 500ms">
        Acompaño tu reforma de principio a fin: decidimos qué se toca y qué no, lo ves antes de
        construirlo y llegas a la obra con todo definido. De 12 a 14 semanas, solo en Barcelona.
      </p>

      <div class="hero__actions reveal" style="--delay: 620ms">
        <a class="btn btn--primary" href={llamada.href}>
          ¿En qué te puedo ayudar?
          <Icon name="arrow" />
        </a>
      </div>

      <!-- Señales de confianza: datos del servicio, sin promesas añadidas -->
      <ul class="hero__trust reveal" style="--delay: 700ms">
        {
          confianza.map((t) => (
            <li>
              <Icon name="check" />
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__media">
      <p class="hero__coords reveal" style="--delay: 1100ms" aria-hidden="true">
        <span>Interiorismo · Reformas</span>
      </p>

      <div class="clip-reveal" style="--delay: 250ms">
        <div data-parallax="0.06">
          <Placeholder
            label="Foto principal"
            note="Un proyecto tuyo terminado, o tú trabajando. Nada de banco de imágenes."
            ratio="4 / 5"
            foto={usarMuestras ? fotos.portada : undefined}
            sizes="(max-width: 900px) 100vw, 40vw"
            eager
          />
        </div>
      </div>

      <a href={site.retoUrl} class="badge reveal" style="--delay: 900ms" aria-label="Reto gratuito: empieza aquí">
        <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true" data-rotate>
          <defs>
            <path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
          </defs>
          <text>
            <textPath href="#badge-circle" textLength="486">{badge}</textPath>
          </text>
        </svg>
        <Isotipo class="badge__mark" tone="light" />
      </a>
    </div>
  </div>

  <div class="container">
    <ul class="hero__facts" aria-label="Femuix en cifras">
      {
        datos.map((d) => (
          <li class="fact reveal">
            <span class="fact__k">{d.etiqueta}</span>
            <p class="fact__v">
              <span class="fact__n" data-count={d.count}>{d.valor}</span>
              <span class="fact__u">{d.unidad}</span>
            </p>
            <p class="fact__d">{d.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(128px, 15vw, 192px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: 32px;
    justify-items: start;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Señales de confianza: en una fila bajo un filete fino; si no caben, saltan enteras */
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    width: 100%;
    margin: 12px 0 0;
    padding: 22px 0 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .hero__trust :global(svg) {
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    color: var(--number);
  }

  .hero__media {
    position: relative;
    isolation: isolate;
  }

  /* Marco dorado desplazado tras la foto, como un paspartú de galería. Empieza bajo las
     coordenadas (línea de 0,625 rem x 1,7 + 18 px de margen) para no cruzarlas */
  .hero__media::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: calc(0.625rem * 1.7 + 18px - 16px);
    left: -16px;
    right: 16px;
    bottom: 16px;
    border: 1px solid var(--gold-line);
    border-radius: var(--radius);
  }

  /* El marco se desliza a su sitio cuando la foto termina de descubrirse */
  @supports selector(:has(*)) {
    :global(.js) .hero__media::after {
      opacity: 0;
      transform: translate(14px, -14px);
      /* Tras la foto (250 ms + lo que tarda en descubrirse), también con la intro (--base) */
      transition:
        opacity var(--t-enter) var(--ease) calc(var(--base, 0ms) + 1s),
        transform var(--t-enter) var(--ease) calc(var(--base, 0ms) + 1s);
    }

    :global(.js) .hero__media:has(.clip-reveal.is-visible)::after {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__media::after {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Bloque de bruma desplazado tras la foto: da profundidad y anuncia el 30 % */
  .hero__media::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 25%;
    right: calc(var(--gutter) * -1);
    bottom: calc(clamp(32px, 4vw, 56px) * -1);
    left: 22%;
    border-radius: var(--radius);
    background: var(--band-image), var(--band);
  }

  /* White UI: la bruma se funde en dorado hacia la esquina inferior derecha */
  :global(:root:not([data-theme='dark'])) .hero__media::before {
    background: linear-gradient(145deg, var(--mist) 0%, var(--mist) 35%, #c9c4a8 65%, var(--warm) 100%);
  }

  /* Dark UI: el gris claro del rombo derecho del símbolo black 2 (#838182) */
  :global([data-theme='dark']) .hero__media::before {
    background: var(--g-500);
  }

  /* Pie editorial de la imagen */
  .hero__coords {
    display: flex;
    justify-content: flex-end;
    gap: 18px;
    margin-bottom: 18px;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__media .clip-reveal {
    overflow: hidden;
    border-radius: var(--radius);
  }

  /* Sello giratorio */
  .badge {
    position: absolute;
    left: clamp(-64px, -5vw, -32px);
    bottom: clamp(-56px, -4vw, -32px);
    display: grid;
    place-items: center;
    width: clamp(120px, 11vw, 156px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--deep);
    color: var(--white);
    text-decoration: none;
    transition: background-color var(--t-color) var(--ease);
  }

  .badge:hover {
    background: var(--green-2);
  }

  /* Dark UI: sello negro azulado con filo gris; al pasar el ratón se enciende el filo */
  :global([data-theme='dark']) .badge {
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    transition:
      background-color var(--t-color) var(--ease),
      box-shadow var(--t-color) var(--ease);
  }

  :global([data-theme='dark']) .badge:hover {
    background: var(--g-800);
    box-shadow: inset 0 0 0 1px var(--warm);
  }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Gira siempre, despacio (rotate), y el scroll le suma su propio giro (motion.ts escribe --rot
       en transform; las dos rotaciones se acumulan). Quieto si el sistema pide reducir el movimiento. */
    transform: rotate(var(--rot, 0deg));
  }

  @media (prefers-reduced-motion: no-preference) {
    .badge__ring {
      animation: badge-spin 24s linear infinite;
    }
  }

  @keyframes badge-spin {
    to {
      rotate: 360deg;
    }
  }

  .badge__ring text {
    fill: var(--warm); /* texto del sello: crema tostada sobre verde (7:1) */
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .badge :global(.badge__mark) {
    width: 30%;
  }

  /* Cifras: sobre blanco, entre dos filetes dorados. Verde pino + dorado, como el sello.
     Dark UI: blanco y grises del logo. */
  .hero__facts {
    --f-num: var(--pine-800);
    --f-unit: var(--gold-deep);
    --f-key: var(--petrol-deep);
    --f-rule: linear-gradient(90deg, transparent, var(--gold-line) 18%, var(--gold-line) 82%, transparent);
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(80px, 10vw, 136px) 0 0;
    padding: clamp(36px, 4vw, 56px) 0;
    list-style: none;
  }

  :global([data-theme='dark']) .hero__facts {
    --f-num: var(--text);
    --f-unit: var(--warm);
    --f-key: var(--muted);
  }

  .hero__facts::before,
  .hero__facts::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--f-rule);
  }

  .hero__facts::before {
    top: 0;
  }

  .hero__facts::after {
    bottom: 0;
  }

  .fact {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 0 clamp(24px, 3.4vw, 52px);
  }

  .fact:first-child {
    padding-left: 0;
  }

  .fact:last-child {
    padding-right: 0;
  }

  .fact + .fact {
    border-left: 1px solid var(--line);
  }

  /* Etiqueta con rombo dorado y filete que se dibuja al aparecer */
  .fact__k {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--f-key);
  }

  .fact__k::before {
    content: '';
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    background: var(--gold-line);
    transform: rotate(45deg);
  }

  .fact__k::after {
    content: '';
    flex: 1;
    max-width: 56px;
    height: 1px;
    background: var(--gold-line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-enter) var(--ease) calc(var(--stagger, 0ms) + var(--base, 0ms) + 300ms);
  }

  .fact.is-visible .fact__k::after {
    transform: scaleX(1);
  }

  .fact__v {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
    margin: 6px 0 0;
  }

  .fact__n {
    font-family: var(--serif);
    font-size: clamp(2.75rem, 4.4vw, 4.5rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--f-num);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Unidad en cursiva: 24 px como mínimo para contar como texto grande */
  .fact__u {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--f-unit);
  }

  .fact__d {
    max-width: 30ch;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Columnas estrechas: la unidad baja bajo la cifra en las tres a la vez */
  @media (max-width: 1080px) {
    .fact__v {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fact__k::after {
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Tablet: imagen apaisada a todo el ancho para que no ocupe una pantalla entera */
    .hero__media {
      width: 100%;
    }
    .hero__media :global(.ph) {
      aspect-ratio: 3 / 2 !important;
    }
    .badge {
      left: 16px;
      bottom: -44px;
    }
  }

  @media (max-width: 640px) {
    .hero__trust {
      flex-direction: column;
      gap: 10px;
    }
    .hero__media :global(.ph) {
      aspect-ratio: 4 / 5 !important;
    }
    .hero__media {
      width: 88%;
      margin-left: auto;
    }
    .hero__actions,
    .hero__actions .btn {
      width: 100%;
    }
    .hero__facts {
      grid-template-columns: minmax(0, 1fr);
      padding: 4px 0;
    }
    .fact,
    .fact:first-child,
    .fact:last-child {
      padding: 26px 0;
    }
    .fact + .fact {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .fact__v {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }
    .badge {
      left: -12px;
      bottom: -40px;
    }
  }
</style>
