---
import BeforeAfter from './BeforeAfter.astro';
import SplitText from './SplitText.astro';
import { testimonios } from '../data/site';
import { fotos, usarMuestras } from '../data/media';

// Mientras no haya testimonios reales, la misma tarjeta con el texto entre corchetes: así se ve
// dónde va cada cosa (como el texto de Sobre mí)
const huecos = [
  {
    cita: '[Una frase real sobre el miedo que tenía antes de empezar y cómo se sintió al recibir las llaves.]',
    nombre: '[Nombre]',
    barrio: '[Barrio]',
  },
  {
    cita: '[Mejor si es una captura de WhatsApp o una reseña de Google, con su permiso.]',
    nombre: '[Nombre]',
    barrio: '[Barrio]',
  },
];
const citas = testimonios.length > 0 ? testimonios : huecos;
---

<section class="section" aria-labelledby="testimonios-title">
  <div class="container">
    <div class="section-head testimonios__head">
      <span class="eyebrow reveal">Testimonios</span>
      <SplitText
        id="testimonios-title"
        class="h-section"
        parts={[{ text: 'Lo que dicen quienes' }, { text: 'ya han pasado por aquí', em: true }]}
      />
      <p class="lead reveal">Pocos y verdaderos.</p>
    </div>

    <div class="testimonios">
      {
        citas.map((t, i) => (
          <blockquote class:list={['quote reveal', { 'quote--tint': i % 2 === 0 }]}>
            <span class="quote__mark" aria-hidden="true">
              “
            </span>
            <p>{t.cita}</p>
            <footer>
              <strong>{t.nombre}</strong>
              <span>{t.barrio}</span>
            </footer>
          </blockquote>
        ))
      }

      <div class="testimonios__wide reveal">
        <BeforeAfter
          note="Mientras no tengas los cinco proyectos fotografiados, enseña el proceso: boceto, render y foto final del mismo rincón."
          antes={usarMuestras ? fotos.antes : undefined}
          despues={usarMuestras ? fotos.despues : undefined}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .testimonios__head {
    max-width: 820px;
  }

  .testimonios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .testimonios__wide {
    grid-column: 1 / -1;
    margin-top: 16px;
  }

  /* Mismo lenguaje que las tarjetas de «Para quién es»: una en bruma suave y otra en filete */
  .quote {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
    padding: clamp(36px, 4vw, 56px);
    border: 1px solid var(--line-strong);
    border-radius: clamp(10px, 1vw, 16px);
    overflow: hidden;
  }

  .quote--tint {
    border-color: transparent;
    background: var(--tint);
  }

  /* Comilla grande en dorado, como una capitular */
  .quote__mark {
    height: 0.5em;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(5rem, 7vw, 7rem);
    line-height: 0.9;
    color: var(--gold-deep);
  }

  .quote p {
    max-width: 30ch;
    font-family: var(--serif);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .quote footer {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .quote strong {
    font-weight: 600;
    color: var(--text);
  }

  /* Rombo dorado entre nombre y barrio */
  .quote footer span::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 14px;
    vertical-align: middle;
    background: var(--gold-line);
    transform: rotate(45deg);
  }

  @media (max-width: 720px) {
    .testimonios {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
