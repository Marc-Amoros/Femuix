---
import Icon from './Icon.astro';
import SplitText from './SplitText.astro';
import { llamada, site, url } from '../data/site';

const dias = [
  { n: 'Día 1', t: 'Qué necesita tu casa de verdad' },
  { n: 'Día 2', t: 'Qué se toca y qué no' },
  { n: 'Día 3', t: 'En qué orden y con qué coste' },
];
---

<section class="section reto" id="reto" aria-labelledby="reto-title">
  <div class="container reto__grid">
    <div class="reto__copy">
      <span class="eyebrow reveal">Empieza aquí</span>
      <SplitText
        id="reto-title"
        class="h-section"
        parts={[{ text: 'El reto gratuito:' }, { text: 'ordena tu reforma antes de gastar un euro', em: true }]}
      />
      <p class="lead reveal">
        Unos días de ejercicios cortos por email. Al terminar sabrás qué reforma necesita tu casa y
        qué preguntas hacer antes de pedir presupuestos.
      </p>

      <ol class="reto__dias">
        {
          dias.map((d, i) => (
            <li class="reveal">
              <span>{d.n}</span>
              {d.t}
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Conectar con el formulario de Systeme.io: pegar la URL de acción en site.systemeFormAction -->
    <form
      class="reto__form band tex-none reveal"
      method="post"
      action={site.systemeFormAction || undefined}
      aria-labelledby="reto-form-title"
      novalidate
      data-reto-form
    >
      <div class="reto__form-head">
        <p class="reto__kicker">Gratis · {dias.length} días · Por email</p>
        <h3 id="reto-form-title" class="reto__form-title">Apúntate al reto</h3>
        <p class="reto__req">Todos los campos son obligatorios.</p>
      </div>

      <div class="field">
        <input
          id="reto-nombre"
          name="first_name"
          type="text"
          autocomplete="given-name"
          placeholder=" "
          required
          aria-describedby="reto-nombre-error"
        />
        <label for="reto-nombre">Nombre</label>
        <p class="field__error" id="reto-nombre-error"></p>
      </div>

      <div class="field">
        <input
          id="reto-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          placeholder=" "
          required
          aria-describedby="reto-email-error"
        />
        <label for="reto-email">Email</label>
        <p class="field__error" id="reto-email-error"></p>
      </div>

      <div>
        <label class="check">
          <input id="reto-privacidad" type="checkbox" name="privacy" required aria-describedby="reto-privacidad-error" />
          <span>
            He leído y acepto la <a class="text-link" href={url('/privacidad')}>política de privacidad</a>.
          </span>
        </label>
        <p class="field__error" id="reto-privacidad-error"></p>
      </div>

      <div class="reto__submit">
        <button class="btn btn--primary" type="submit">
          Quiero empezar el reto
          <Icon name="arrow" />
        </button>
        <p class="reto__safe">Sin compromiso. Te das de baja desde cualquier email.</p>
      </div>

      <!-- Primera capa de información de privacidad (RGPD). Revisar con quien redacte los textos legales. -->
      <p class="reto__legal">
        Responsable: Femuix. Finalidad: enviarte el reto y emails sobre Femuix. Legitimación: tu
        consentimiento. Puedes darte de baja desde cualquier email y ejercer tus derechos escribiendo a{' '}
        {site.email}.
      </p>

      <div class="reto__alt">
        <span class="reto__or" aria-hidden="true">o</span>
        <p class="reto__alt-q">¿Prefieres hablar directamente?</p>
        <!-- Texto corto en una sola línea: el email (o «Reservar una llamada» cuando haya agenda) -->
        <a class="reto__alt-link" href={llamada.href}>
          <Icon name="mail" />
          <span>{llamada.activa ? llamada.reservar : site.email}</span>
          <Icon name="arrow" />
        </a>
      </div>

      <!-- Región de estado siempre presente para que el mensaje se anuncie al rellenarse -->
      <p class="reto__ok" role="status" data-reto-ok></p>
    </form>
  </div>
</section>

<script>
  // Validación accesible: mensajes en español junto a cada campo (WCAG 3.3.1 y 3.3.3).
  const form = document.querySelector<HTMLFormElement>('[data-reto-form]');

  if (form) {
    const fields = [...form.querySelectorAll<HTMLInputElement>('input[required]')];
    const ok = form.querySelector<HTMLElement>('[data-reto-ok]');

    const message = (input: HTMLInputElement) => {
      if (input.validity.valueMissing) {
        if (input.type === 'checkbox')
          return 'Para enviarte el reto necesito que aceptes la política de privacidad.';
        return input.type === 'email' ? 'Escribe tu email.' : 'Escribe tu nombre.';
      }
      if (input.validity.typeMismatch) return 'Revisa el email: debe tener el formato nombre@dominio.com.';
      return '';
    };

    const check = (input: HTMLInputElement) => {
      const msg = message(input);
      const error = document.getElementById(input.getAttribute('aria-describedby') ?? '');
      if (error) error.textContent = msg;
      if (msg) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      return !msg;
    };

    for (const input of fields) {
      // Se valida al salir del campo y se corrige en cuanto el error desaparece
      input.addEventListener('blur', () => {
        if (input.value || input.hasAttribute('aria-invalid')) check(input);
      });
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) check(input);
      });
      input.addEventListener('change', () => {
        if (input.type === 'checkbox') check(input);
      });
    }

    form.addEventListener('submit', (e) => {
      const invalid = fields.filter((input) => !check(input));
      if (invalid.length) {
        e.preventDefault();
        invalid[0].focus();
        return;
      }
      // Mientras no haya URL de Systeme.io, no se envía y se muestra la confirmación
      if (form.getAttribute('action')) return;
      e.preventDefault();
      if (ok) ok.textContent = 'Gracias. Revisa tu bandeja de entrada: el primer email del reto ya va de camino.';
      form.reset();
    });
  }
</script>

<style>
  .reto__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .reto__copy {
    display: grid;
    gap: 28px;
  }

  .reto__dias {
    display: grid;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .reto__dias li {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .reto__dias span {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--number);
    padding-top: 6px;
  }

  /* Tarjeta del formulario: bruma, tipografía editorial y campos de línea fina */
  .reto__form {
    display: grid;
    gap: 30px;
    padding: clamp(32px, 4vw, 56px);
    border-radius: var(--radius-lg);
  }

  .reto__form-head {
    display: grid;
    gap: 10px;
  }

  .reto__kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--number);
  }

  .reto__kicker::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--gold-line);
    transform: rotate(45deg);
  }

  .reto__form-title {
    font-family: var(--serif);
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .reto__req {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Campo editorial: etiqueta en versalitas encima y línea fina que se dibuja al enfocar */
  .field {
    display: flex;
    flex-direction: column;
  }

  .field label {
    order: -1;
    margin-bottom: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.4s var(--ease);
  }

  .field:focus-within label {
    color: var(--text);
  }

  .field input {
    width: 100%;
    height: 42px;
    padding: 4px 0;
    border: 0;
    border-bottom: 1px solid var(--line-ui); /* ≥3:1, WCAG 1.4.11 */
    border-radius: 0;
    background: transparent;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 2px;
    background-position: left bottom;
    background-repeat: no-repeat;
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--text);
    transition: background-size 0.6s var(--ease);
  }

  .field input:focus {
    outline: none;
    background-size: 100% 2px;
  }

  /* Campo con error: línea y mensaje en el color de error (con texto, no solo color) */
  .field input[aria-invalid='true'] {
    border-bottom-color: var(--error);
    background-image: linear-gradient(var(--error), var(--error));
  }

  .field__error {
    margin-top: 8px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--error);
  }

  .field__error:empty {
    display: none;
  }

  .check {
    display: flex;
    gap: 12px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Casilla propia: igual en modo día y noche, borde ≥3:1 (WCAG 1.4.11) */
  .check input {
    appearance: none;
    -webkit-appearance: none;
    display: grid;
    place-content: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    border: 1px solid var(--line-ui);
    border-radius: 3px;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .check input::after {
    content: '';
    width: 12px;
    height: 6px;
    margin-top: -3px;
    border-left: 2px solid var(--bg);
    border-bottom: 2px solid var(--bg);
    transform: rotate(-45deg) scale(0);
    transition: transform 0.25s var(--ease);
  }

  .check input:checked {
    border-color: var(--ink);
    background: var(--ink);
  }

  .check input:checked::after {
    transform: rotate(-45deg) scale(1);
  }

  .check input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .reto__submit {
    display: grid;
    gap: 12px;
    margin-top: 4px;
  }

  .reto__form .btn {
    width: 100%;
  }

  .reto__safe {
    font-family: var(--serif);
    font-size: 0.9375rem;
    font-style: italic;
    font-weight: 400;
    color: var(--muted);
    text-align: center;
  }

  /* Letra pequeña separada por un filete */
  .reto__legal {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Alternativa: hablar directamente, tras un separador «o» */
  .reto__alt {
    display: grid;
    gap: 14px;
    text-align: center;
  }

  .reto__alt-q {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Enlace sutil pero visible: icono, texto subrayado y flecha que avanza al señalarlo */
  .reto__alt-link {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    gap: 10px;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }

  .reto__alt-link span {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--ink);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-thickness 0.3s var(--ease);
  }

  .reto__alt-link :global(svg) {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .reto__alt-link :global(svg:last-child) {
    width: 16px;
    height: 16px;
    transition: transform 0.6s var(--ease);
  }

  .reto__alt-link:focus-visible span {
    text-decoration-thickness: 2px;
  }

  .reto__alt-link:focus-visible :global(svg:last-child) {
    transform: translateX(4px);
  }

  @media (hover: hover) {
    .reto__alt-link:hover span {
      text-decoration-thickness: 2px;
    }
    .reto__alt-link:hover :global(svg:last-child) {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reto__alt-link :global(svg:last-child) {
      transition: none;
    }
  }

  .reto__or {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
  }

  .reto__or::before,
  .reto__or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .reto__ok:empty {
    display: none;
  }

  .reto__ok {
    padding: 14px 16px;
    border-left: 3px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: 0.875rem;
  }

  @media (max-width: 900px) {
    .reto__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
