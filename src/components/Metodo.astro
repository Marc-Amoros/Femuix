---
import SplitText from './SplitText.astro';
import { fases } from '../data/site';
---

<section class="section band band--teal tex-none metodo" id="metodo" data-expand aria-labelledby="metodo-title">
  <div class="container metodo__grid">
    <div class="metodo__aside">
      <div class="metodo__sticky">
        <span class="eyebrow reveal">El método</span>
        <SplitText
          id="metodo-title"
          class="h-section"
          parts={[{ text: 'El método Femuix: cuatro fases,' }, { text: 'en este orden y por algo', em: true }]}
        />
        <p class="lead reveal">
          Cada fase es un producto cerrado con hasta dos rondas de revisión. Se paga al abrirla y
          puedes parar al final de cualquiera de ellas.
        </p>

        <nav aria-label="Fases del método">
          <ol class="metodo__index">
            {
              fases.map((f, i) => (
                <li class="reveal">
                  <a
                    href={`#fase-${f.n}`}
                    data-phase-link={i}
                    class:list={{ 'is-active': i === 0 }}
                    aria-current={i === 0 ? 'step' : undefined}
                  >
                    <span>{f.n}</span>
                    {f.nombre}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </div>

    <!-- Las tarjetas se apilan unas sobre otras al hacer scroll -->
    <ol class="fases">
      {
        fases.map((f, i) => (
          <li class="fase" id={`fase-${f.n}`} style={`--i: ${i}`} data-phase={i} data-reveal-unit>
            <div class="fase__top reveal">
              <span class="fase__label">Fase {f.n}</span>
              <span class="fase__n" aria-hidden="true">
                {f.n}
              </span>
            </div>
            <h3 class="fase__name reveal">{f.nombre}</h3>
            <p class="fase__text reveal">{f.texto}</p>
            <p class="fase__deliver reveal">
              <span>Te llevas</span>
              {f.entregable}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Las tarjetas se apilan al hacer scroll. La activa es la última que ha llegado a su sitio;
  // las anteriores se reducen un poco (--depth) y el índice marca la activa.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-phase]')];
  const links = document.querySelectorAll<HTMLElement>('[data-phase-link]');
  let ticking = false;

  const update = () => {
    ticking = false;
    let active = 0;
    cards.forEach((card, i) => {
      const stickyTop = parseFloat(getComputedStyle(card).top) || 0;
      if (card.getBoundingClientRect().top <= stickyTop + 2) active = i;
    });
    cards.forEach((card, i) => card.style.setProperty('--depth', String(Math.max(0, active - i))));
    links.forEach((l) => {
      const on = Number(l.dataset.phaseLink) === active;
      l.classList.toggle('is-active', on);
      if (on) l.setAttribute('aria-current', 'step');
      else l.removeAttribute('aria-current');
    });
  };

  // Al pulsar un punto del índice se baja hasta su tarjeta. Las tarjetas son pegajosas, así que
  // su posición en pantalla no sirve: se calcula la natural sumando las anteriores y el hueco.
  const list = document.querySelector<HTMLElement>('.fases');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  cards.forEach((card) => card.setAttribute('tabindex', '-1'));
  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      if (!list) return;
      e.preventDefault();
      const i = Number(link.dataset.phaseLink);
      const gap = parseFloat(getComputedStyle(list).rowGap) || 0;
      let y = list.getBoundingClientRect().top + window.scrollY;
      for (let j = 0; j < i; j++) y += cards[j].offsetHeight + gap;
      y -= parseFloat(getComputedStyle(cards[i]).top) || 0;
      const lenis = (window as Window & { lenis?: { scrollTo: (y: number, o?: object) => void } })
        .lenis;
      if (lenis) lenis.scrollTo(y + 2, { immediate: reduceMotion });
      else window.scrollTo({ top: y + 2, behavior: reduceMotion ? 'auto' : 'smooth' });
      cards[i].focus({ preventScroll: true });
    });
  });

  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();
</script>

<style>
  .metodo__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .metodo__aside {
    align-self: stretch;
  }

  .metodo__sticky {
    position: sticky;
    top: 128px;
    display: grid;
    gap: 28px;
  }

  .metodo__index {
    display: grid;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .metodo__index li {
    border-top: 1px solid var(--line);
  }

  /* Cada punto es un enlace a su tarjeta. Al pasar el ratón la fila se oscurece; la activa se
     oscurece más, pasa a cursiva dorada y lleva una raya dorada (no solo color: WCAG 1.4.1).
     El fondo solo oscurece el petróleo, así el contraste del texto sube en vez de bajar. */
  .metodo__index a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 4px -14px;
    padding: 10px 14px;
    border-radius: 8px;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease),
      padding var(--t-color) var(--ease);
  }

  .metodo__index a:hover {
    background: rgba(14, 32, 27, 0.18);
  }

  .metodo__index a span {
    color: var(--number);
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  .metodo__index a::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 50%;
    width: 22px;
    height: 1px;
    background: var(--warm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-move) var(--ease);
  }

  .metodo__index a.is-active {
    padding-left: 50px;
    background: rgba(14, 32, 27, 0.45); /* fila activa: el dorado llega a 7,7:1 */
    color: var(--em);
    font-style: italic;
  }

  .metodo__index a.is-active span {
    color: var(--em);
  }

  .metodo__index a.is-active::before {
    transform: none;
  }

  :global([data-theme='dark']) .metodo__index a:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  /* Fila activa: se oscurece para que el dorado llegue a 9:1 */
  :global([data-theme='dark']) .metodo__index a.is-active {
    background: rgba(0, 0, 0, 0.35);
  }

  .fase:focus {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .metodo__index a,
    .metodo__index a::before {
      transition: none;
    }
  }

  /* El espacio entre tarjetas va en la lista (gap), no en cada tarjeta: un margin-bottom
     cuenta como parte de la tarjeta pegajosa y la despegaba antes de tiempo */
  .fases {
    display: grid;
    gap: 22vh;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Mazo de tarjetas: cada una se detiene 16 px más abajo que la anterior, que se reduce un
     3,5 % por cada tarjeta que tiene encima y asoma solo como un canto fino */
  .fase {
    position: sticky;
    top: calc(128px + var(--i) * 16px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: clamp(400px, 54vh, 500px);
    padding: clamp(32px, 4vw, 56px);
    background: var(--surface);
    color: var(--text);
    border-radius: var(--radius-lg);
    box-shadow:
      0 0 0 1px rgba(29, 60, 52, 0.06),
      0 30px 60px -40px rgba(14, 32, 27, 0.55);
    transform: scale(calc(1 - var(--depth, 0) * 0.035));
    transform-origin: 50% 0;
    transition: transform var(--t-move) var(--ease);
  }

  :global([data-theme='dark']) .fase {
    box-shadow:
      0 0 0 1px rgba(131, 129, 130, 0.35),
      0 30px 60px -40px rgba(0, 0, 0, 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .fase {
      transition: none;
    }
  }


  .fase__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .fase__label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--number);
  }

  /* Modo día: número de fase en azul petróleo sobre la tarjeta blanca */
  :global(:root:not([data-theme='dark'])) .fase {
    --text: #111111;
    --muted: #4a4a4a;
    --ink: var(--pine-800);
    --number: var(--petrol-deep);
    --line: rgba(29, 60, 52, 0.13);
  }

  .fase__n {
    font-family: var(--serif);
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    font-weight: 300;
    font-style: italic;
    line-height: 0.8;
    color: var(--number);
  }

  .fase__name {
    font-size: clamp(2.2rem, 3.6vw, 3.2rem);
  }

  .fase__text {
    color: var(--muted);
    font-size: 1.0625rem;
    max-width: 36ch;
  }

  .fase__deliver {
    display: grid;
    gap: 4px;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .fase__deliver span {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .metodo__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .metodo__sticky {
      position: static;
    }
    .metodo__index {
      display: none;
    }
    .fases {
      gap: 12vh;
    }
    .fase {
      top: calc(88px + var(--i) * 12px);
      min-height: 360px;
    }
  }
</style>
