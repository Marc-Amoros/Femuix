---
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import { site, url } from '../data/site';
---

<!-- «Cuéntame tu reforma»: ventana con el formulario de contacto. La abren los botones con
     data-contacto; sin JavaScript esos botones abren el email. <dialog> en modo modal ya atrapa
     el foco, se cierra con Escape y deja inerte el resto de la página. -->
<dialog class="contacto" aria-labelledby="contacto-title" data-contacto-dialog data-lenis-prevent>
  <button class="contacto__close" type="button" aria-label="Cerrar" data-contacto-close>
    <Icon name="close" />
  </button>

  <div class="contacto__scroll">
    <div class="contacto__grid">
      <div class="contacto__copy">
        <span class="eyebrow">Empieza aquí</span>
        <h2 id="contacto-title" class="h-display contacto__title" tabindex="-1">
          Cuéntame <em>tu reforma</em>
        </h2>

        <figure class="contacto__quote">
          <blockquote>
            <p>Soy Andrea, trabajo en Barcelona y hablas siempre conmigo, de principio a fin.</p>
          </blockquote>
          <figcaption>
            <Isotipo class="contacto__mark" />
            Andrea · Fundadora de Femuix
          </figcaption>
        </figure>
      </div>

      <form
        class="contacto__form band tex-none"
        method="post"
        action={site.contactoAction || undefined}
        aria-labelledby="contacto-title"
        novalidate
        data-contacto-form
        data-paso-actual="1"
      >
        <div class="contacto__fields">
          <div class="contacto__top">
            <p class="contacto__req">Dos pasos · todo obligatorio</p>
            <!-- Progreso: decorativo; el paso en que estás lo dice el título de cada paso -->
            <div class="pasos" aria-hidden="true"><i></i><i></i></div>
          </div>

          <!-- Paso 1: cómo responderte. Los avisos son regiones en vivo, siempre presentes: se
               anuncian al rellenarse (WCAG 4.1.3) -->
          <div class="paso" data-paso>
            <h3 class="paso__title" tabindex="-1" data-paso-title>
              <span class="paso__n">Paso 1 de 2</span>{' '}
              Tus datos
            </h3>

            <div class="field">
              <label for="contacto-nombre">Nombre</label>
              <input
                id="contacto-nombre"
                name="nombre"
                type="text"
                autocomplete="name"
                required
                aria-describedby="contacto-nombre-error"
              />
              <p class="field__error" id="contacto-nombre-error" aria-live="polite"></p>
            </div>

            <div class="contacto__pair">
              <div class="field">
                <label for="contacto-email">Email</label>
                <input
                  id="contacto-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  inputmode="email"
                  required
                  aria-describedby="contacto-email-error"
                />
                <p class="field__error" id="contacto-email-error" aria-live="polite"></p>
              </div>

              <div class="field">
                <label for="contacto-telefono">Teléfono</label>
                <input
                  id="contacto-telefono"
                  name="telefono"
                  type="tel"
                  autocomplete="tel"
                  inputmode="tel"
                  required
                  aria-describedby="contacto-telefono-hint contacto-telefono-error"
                />
                <p class="field__hint" id="contacto-telefono-hint">Para responderte por WhatsApp.</p>
                <p class="field__error" id="contacto-telefono-error" aria-live="polite"></p>
              </div>
            </div>

            <div class="contacto__submit">
              <button class="btn btn--primary" type="submit">
                Continuar
                <Icon name="arrow" />
              </button>
              <p class="contacto__safe">Sin compromiso. Después, tu reforma en tres preguntas.</p>
            </div>
          </div>

          <!-- Paso 2: la reforma. Filtra lo que no hago (viviendas fuera de Barcelona ciudad) -->
          <div class="paso" data-paso hidden>
            <h3 class="paso__title" tabindex="-1" data-paso-title>
              <span class="paso__n">Paso 2 de 2</span>{' '}
              Tu reforma
            </h3>

            <fieldset class="choice" aria-describedby="contacto-reforma-error">
              <legend>Qué quieres reformar</legend>
              <div class="choice__options">
                {
                  ['Toda la vivienda', 'Cocina o baños', 'Varias estancias'].map((v) => (
                    <label class="choice__opt">
                      <input type="radio" name="reforma" value={v} required />
                      <span>{v}</span>
                    </label>
                  ))
                }
              </div>
              <p class="field__error" id="contacto-reforma-error" aria-live="polite"></p>
            </fieldset>

            <fieldset class="choice" aria-describedby="contacto-zona-error">
              <legend>Dónde está la vivienda</legend>
              <div class="choice__options">
                {
                  ['Barcelona ciudad', 'Fuera de Barcelona'].map((v) => (
                    <label class="choice__opt">
                      <input type="radio" name="zona" value={v} required />
                      <span>{v}</span>
                    </label>
                  ))
                }
              </div>
              <p class="field__error" id="contacto-zona-error" aria-live="polite"></p>
            </fieldset>

            <div class="field">
              <label for="contacto-mensaje">Qué te gustaría cambiar</label>
              <textarea
                id="contacto-mensaje"
                name="mensaje"
                rows="3"
                required
                aria-describedby="contacto-mensaje-hint contacto-mensaje-error"></textarea>
              <p class="field__hint" id="contacto-mensaje-hint">
                Por ejemplo: piso de 80 m² en Gràcia, abrir la cocina al salón y rehacer el baño.
              </p>
              <p class="field__error" id="contacto-mensaje-error" aria-live="polite"></p>
            </div>

            <div>
              <label class="check">
                <input
                  id="contacto-privacidad"
                  type="checkbox"
                  name="privacidad"
                  required
                  aria-describedby="contacto-privacidad-error"
                />
                <span>
                  He leído y acepto la <a class="text-link" href={url('/privacidad')}>política de privacidad</a>.
                </span>
              </label>
              <p class="field__error" id="contacto-privacidad-error" aria-live="polite"></p>
            </div>

            <div class="contacto__submit">
              <button class="btn btn--primary" type="submit">
                Enviar mi reforma
                <Icon name="arrow" />
              </button>
              <button class="paso__back" type="button" data-paso-back>
                <Icon name="arrow" />
                Volver a tus datos
              </button>
              <p class="contacto__safe">
                Lo leo yo y, si encaja, te propongo una llamada gratuita. No te apunto a ninguna lista.
              </p>
            </div>

            <!-- Primera capa de información de privacidad (RGPD). Revisar con quien redacte los textos legales. -->
            <p class="contacto__legal">
              [Primera capa de privacidad: responsable, finalidad (valorar tu consulta y responderte,
              también por WhatsApp), legitimación y derechos. Pendiente de revisión legal.]
            </p>
          </div>
        </div>

        <!-- Confirmación: sustituye a los campos al enviar y recibe el foco para que se anuncie -->
        <div class="contacto__done" data-contacto-done hidden>
          <Isotipo class="contacto__done-mark" />
          <p class="contacto__done-title" tabindex="-1" data-contacto-done-title></p>
          <p class="contacto__done-text" data-contacto-done-text></p>
          <button class="btn btn--primary" type="button" data-contacto-close>Cerrar</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { site } from '../data/site';

  const dialog = document.querySelector<HTMLDialogElement>('[data-contacto-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-contacto-form]');

  if (dialog && form) {
    type Control = HTMLInputElement | HTMLTextAreaElement;
    const steps = [...form.querySelectorAll<HTMLElement>('[data-paso]')];
    const done = form.querySelector<HTMLElement>('[data-contacto-done]');
    const doneTitle = form.querySelector<HTMLElement>('[data-contacto-done-title]');
    const doneText = form.querySelector<HTMLElement>('[data-contacto-done-text]');
    const fieldset = form.querySelector<HTMLElement>('.contacto__fields');
    let trigger: HTMLElement | null = null;

    // ---------- Abrir y cerrar ----------

    const open = (from: HTMLElement | null) => {
      trigger = from;
      // Si se envió antes, la ventana vuelve a mostrar el formulario vacío, desde el primer paso.
      // Si se cerró a medias, lo escrito se conserva y se sigue donde se dejó
      if (done && !done.hidden) {
        done.hidden = true;
        fieldset?.removeAttribute('hidden');
        goTo(0, false);
      }
      dialog.showModal();
      window.lenis?.stop();
      // El foco empieza en el título: el lector de pantalla lo lee y el tabulador sigue al formulario
      dialog.querySelector<HTMLElement>('#contacto-title')?.focus();
    };

    // Al cerrar, la ventana baja y se desvanece con el fondo antes de cerrarse de verdad
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const OUT = 320; // lo que dura contacto-out
    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reduceMotion) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(() => {
        dialog.classList.remove('is-closing');
        dialog.close();
      }, OUT);
    };

    // Escape también cierra con la animación (si el navegador deja retener el cierre)
    dialog.addEventListener('cancel', (e) => {
      if (!e.cancelable) return;
      e.preventDefault();
      close();
    });

    dialog.addEventListener('close', () => {
      window.lenis?.start();
      trigger?.focus();
    });

    // Los botones con data-contacto abren la ventana en lugar del email
    document.querySelectorAll<HTMLAnchorElement>('[data-contacto]').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(link);
      });
    });

    dialog.querySelectorAll('[data-contacto-close]').forEach((btn) => btn.addEventListener('click', close));

    // Un clic en el fondo oscuro (fuera de la ventana) también la cierra
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    // ---------- Validación accesible (WCAG 3.3.1 y 3.3.3) ----------
    // Se valida por nombre de campo: un grupo de opciones (radio) cuenta como un solo campo

    const inputsOf = (name: string) => [...form.querySelectorAll<Control>(`[name="${name}"]`)];

    const valueOf = (name: string) => {
      const inputs = inputsOf(name);
      const first = inputs[0] as HTMLInputElement | undefined;
      if (first?.type === 'radio') return inputs.find((i) => (i as HTMLInputElement).checked)?.value ?? '';
      if (first?.type === 'checkbox') return first.checked ? 'sí' : '';
      return first?.value.trim() ?? '';
    };

    const message = (name: string) => {
      const value = valueOf(name);
      switch (name) {
        case 'reforma':
          return value ? '' : 'Elige qué quieres reformar.';
        case 'zona':
          if (!value) return 'Dime dónde está la vivienda.';
          return value === 'Fuera de Barcelona'
            ? 'Solo trabajo en Barcelona ciudad, porque piso cada obra que acompaño. Fuera de la ciudad no podría hacerlo bien.'
            : '';
        case 'mensaje':
          return value ? '' : 'Cuéntame en pocas palabras qué te gustaría cambiar.';
        case 'nombre':
          return value ? '' : 'Escribe tu nombre.';
        case 'email':
          if (!value) return 'Escribe tu email.';
          return (inputsOf(name)[0] as HTMLInputElement).validity.typeMismatch
            ? 'Revisa el email: debe tener el formato nombre@dominio.com.'
            : '';
        case 'telefono':
          if (!value) return 'Escribe tu teléfono.';
          return value.replace(/\D/g, '').length < 9
            ? 'Revisa el teléfono: escribe al menos 9 cifras, por ejemplo 612 345 678.'
            : '';
        case 'privacidad':
          return value ? '' : 'Para responderte necesito que aceptes la política de privacidad.';
        default:
          return '';
      }
    };

    const check = (name: string) => {
      const msg = message(name);
      const error = document.getElementById(`contacto-${name}-error`);
      if (error) error.textContent = msg;
      for (const input of inputsOf(name)) {
        if (msg) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
      return !msg;
    };

    // El foco va al campo con error; en un grupo de opciones, a la elegida o a la primera
    const focusField = (name: string) => {
      const inputs = inputsOf(name);
      (inputs.find((i) => (i as HTMLInputElement).checked) ?? inputs[0])?.focus();
    };

    const namesIn = (scope: Element) => [
      ...new Set([...scope.querySelectorAll<Control>('[required]')].map((input) => input.name)),
    ];

    for (const input of form.querySelectorAll<Control>('[required]')) {
      // Se valida al salir del campo y se corrige en cuanto el error desaparece; una opción, al elegirla
      input.addEventListener('blur', () => {
        if (input.type !== 'radio' && (input.value || input.hasAttribute('aria-invalid'))) check(input.name);
      });
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) check(input.name);
      });
      input.addEventListener('change', () => {
        if (input.type === 'checkbox' || input.type === 'radio') check(input.name);
      });
    }

    // ---------- Pasos ----------

    let step = 0;

    // Al cambiar de paso, el foco va a su título («Paso 2 de 2, Tu reforma») para que el
    // lector de pantalla lo anuncie y el tabulador siga desde ahí
    function goTo(n: number, focus = true) {
      step = n;
      steps.forEach((el, i) => (el.hidden = i !== n));
      form!.dataset.pasoActual = String(n + 1);
      if (focus) steps[n].querySelector<HTMLElement>('[data-paso-title]')?.focus();
    }

    form.querySelector('[data-paso-back]')?.addEventListener('click', () => goTo(0));

    // ---------- Envío ----------

    const showDone = (title: string, text: string) => {
      if (!done || !doneTitle || !doneText) return;
      doneTitle.textContent = title;
      doneText.textContent = text;
      fieldset?.setAttribute('hidden', '');
      done.hidden = false;
      doneTitle.focus();
    };

    // Enviar el paso 1 (botón «Continuar» o Intro) lleva al paso 2; enviar el paso 2 envía el formulario
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = namesIn(steps[step]).filter((name) => !check(name));
      if (invalid.length) {
        focusField(invalid[0]);
        return;
      }
      if (step === 0) {
        goTo(1);
        return;
      }

      const data = new FormData(form);
      const nombre = String(data.get('nombre')).trim();
      const gracias = `Gracias, ${nombre}.`;

      // Con servicio de formularios: se envía sin salir de la página
      if (site.contactoAction) {
        try {
          const res = await fetch(site.contactoAction, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          goTo(0, false);
          showDone(
            gracias,
            'He recibido tu reforma. La leo yo y, si encaja, te propongo una llamada gratuita de 30 a 45 minutos.',
          );
        } catch {
          showDone(
            'No se ha podido enviar.',
            `Vuelve a intentarlo en un momento o escríbeme directamente a ${site.email}.`,
          );
        }
        return;
      }

      // Sin servicio: se abre el correo con el mensaje ya redactado
      const body = [
        `Qué quiero reformar: ${data.get('reforma')}`,
        `Dónde está la vivienda: ${data.get('zona')}`,
        '',
        String(data.get('mensaje')).trim(),
        '',
        `Nombre: ${nombre}`,
        `Email: ${String(data.get('email')).trim()}`,
        `Teléfono: ${String(data.get('telefono')).trim()}`,
      ].join('\n');
      const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Mi reforma · ${nombre}`)}&body=${encodeURIComponent(body)}`;
      window.open(mailto, '_self');
      form.reset();
      goTo(0, false);
      showDone(gracias, 'Se ha abierto tu correo con el mensaje preparado: solo falta enviarlo.');
    });
  }
</script>

<style>
  /* ---------- Ventana ---------- */

  .contacto {
    width: min(1040px, 100% - 48px);
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 48px 120px -40px rgba(14, 32, 27, 0.55);
    overflow: hidden;
  }

  .contacto[open] {
    display: flex;
  }

  .contacto::backdrop {
    background: rgba(14, 32, 27, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* Dark UI: fondo negro, sin verde */
  :global([data-theme='dark']) .contacto::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }

  :global([data-theme='dark']) .contacto {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 48px 120px -40px rgba(0, 0, 0, 0.8);
  }

  /* La página de detrás no se desplaza mientras la ventana está abierta */
  :global(html:has(.contacto[open])) {
    overflow: hidden;
  }

  /* El contenido se desplaza dentro; el botón de cerrar queda fijo en la esquina */
  .contacto__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(28px, 3.5vw, 48px) clamp(20px, 3.5vw, 48px);
  }

  .contacto__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .contacto__close :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .contacto__close:hover {
      background: var(--ink);
      color: var(--bg);
    }
  }

  /* Entrada: sube y aparece; el fondo se oscurece a la vez */
  @media (prefers-reduced-motion: no-preference) {
    .contacto[open] {
      animation: contacto-in 0.55s var(--ease);
    }
    .contacto[open]::backdrop {
      animation: contacto-fondo 0.4s var(--ease);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .contacto.is-closing {
      animation: contacto-out 0.32s var(--ease-in-out) forwards;
      pointer-events: none;
    }
    .contacto.is-closing::backdrop {
      animation: contacto-fondo-out 0.32s var(--ease-in-out) forwards;
    }
  }

  @keyframes contacto-out {
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.985);
    }
  }

  @keyframes contacto-fondo-out {
    to {
      opacity: 0;
    }
  }

  @keyframes contacto-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @keyframes contacto-fondo {
    from {
      opacity: 0;
    }
  }

  /* ---------- Contenido ---------- */

  .contacto__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: clamp(24px, 3.5vw, 56px);
    align-items: start;
  }

  .contacto__copy {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    justify-items: start;
  }

  /* Corte natural, sin equilibrar: «Cuéntame tu / reforma» */
  .contacto .contacto__title {
    margin: 0;
    margin-top: -6px;
    font-size: clamp(2rem, 3.8vw, 3.25rem);
    text-wrap: wrap;
  }

  /* Fuera de <main> el rótulo no lleva número: solo el filete, en dorado */
  .contacto .eyebrow::before {
    background: var(--gold-line);
  }

  .contacto__title:focus {
    outline: none;
  }

  /* Cita de Andrea con filete dorado y firma */
  .contacto__quote {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 2px 0 2px clamp(18px, 2vw, 24px);
    border-left: 2px solid var(--gold-line);
  }

  .contacto__quote blockquote {
    margin: 0;
  }

  .contacto__quote p {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--number);
    text-wrap: pretty;
  }

  .contacto__quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contacto__quote :global(.contacto__mark) {
    flex-shrink: 0;
    width: 28px;
  }

  /* ---------- Formulario: tarjeta de bruma con campos de línea fina ---------- */

  .contacto__form {
    padding: clamp(20px, 2.6vw, 32px);
    border-radius: var(--radius-lg);
  }

  .contacto__fields {
    display: grid;
    gap: 18px;
  }

  .contacto__top {
    display: grid;
    gap: 10px;
  }

  .contacto__fields[hidden] {
    display: none;
  }

  .contacto__req {
    font-size: 0.8125rem;
    color: var(--text);
  }

  /* ---------- Pasos ---------- */

  /* Barra de dos tramos: el segundo se llena al pasar al paso 2 */
  .pasos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .pasos i {
    position: relative;
    height: 2px;
    overflow: hidden;
    background: var(--line-strong);
  }

  .pasos i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-enter) var(--ease);
  }

  .pasos i:first-child::after,
  .contacto__form[data-paso-actual='2'] .pasos i::after {
    transform: none;
  }

  .paso {
    display: grid;
    gap: 16px;
  }

  .paso[hidden] {
    display: none;
  }

  /* Cada paso entra con un desliz corto hacia la izquierda, como una página que pasa */
  @media (prefers-reduced-motion: no-preference) {
    .paso {
      animation: paso-in 0.5s var(--ease);
    }
  }

  @keyframes paso-in {
    from {
      opacity: 0;
      transform: translateX(16px);
    }
  }

  .paso__title {
    display: grid;
    gap: 4px;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 300;
    line-height: 1.15;
  }

  .paso__title:focus {
    outline: none;
  }

