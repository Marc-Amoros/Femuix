---
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import { site, url } from '../data/site';
---

<!-- «Cuéntame tu reforma»: ventana con el formulario de contacto. La abren los botones con
     data-contacto; sin JavaScript esos botones abren el email. <dialog> en modo modal ya atrapa
     el foco, se cierra con Escape y deja inerte el resto de la página. -->
<dialog class="contacto" aria-labelledby="contacto-title" data-contacto-dialog data-lenis-prevent>
  <button class="contacto__close" type="button" aria-label="Cerrar" data-contacto-close>
    <Icon name="close" />
  </button>

  <div class="contacto__scroll">
    <div class="contacto__grid">
      <div class="contacto__copy">
        <span class="eyebrow">Empieza aquí</span>
        <h2 id="contacto-title" class="h-display contacto__title" tabindex="-1">
          Cuéntame <em>tu reforma</em>
        </h2>

        <figure class="contacto__quote">
          <blockquote>
            <p>Soy Andrea, trabajo en Barcelona y hablas siempre conmigo, de principio a fin.</p>
          </blockquote>
          <figcaption>
            <Isotipo class="contacto__mark" />
            Andrea · Fundadora de Femuix
          </figcaption>
        </figure>
      </div>

      <form
        class="contacto__form band tex-none"
        method="post"
        action={site.contactoAction || undefined}
        aria-labelledby="contacto-title"
        novalidate
        data-contacto-form
      >
        <div class="contacto__fields">
          <p class="contacto__req">Todos los campos son obligatorios.</p>

          <!-- Los avisos son regiones en vivo, siempre presentes: se anuncian al rellenarse (WCAG 4.1.3) -->
          <div class="contacto__pair">
            <div class="field">
              <label for="contacto-nombre">Nombre</label>
              <input
                id="contacto-nombre"
                name="nombre"
                type="text"
                autocomplete="name"
                required
                aria-describedby="contacto-nombre-error"
              />
              <p class="field__error" id="contacto-nombre-error" aria-live="polite"></p>
            </div>

            <div class="field">
              <label for="contacto-email">Email</label>
              <input
                id="contacto-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                aria-describedby="contacto-email-error"
              />
              <p class="field__error" id="contacto-email-error" aria-live="polite"></p>
            </div>
          </div>

          <div class="field">
            <label for="contacto-telefono">Teléfono</label>
            <input
              id="contacto-telefono"
              name="telefono"
              type="tel"
              autocomplete="tel"
              inputmode="tel"
              required
              aria-describedby="contacto-telefono-hint contacto-telefono-error"
            />
            <p class="field__hint" id="contacto-telefono-hint">Para responderte por WhatsApp.</p>
            <p class="field__error" id="contacto-telefono-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label for="contacto-mensaje">Qué quieres reformar y dónde está la vivienda</label>
            <textarea
              id="contacto-mensaje"
              name="mensaje"
              rows="4"
              required
              aria-describedby="contacto-mensaje-error"></textarea>
            <p class="field__error" id="contacto-mensaje-error" aria-live="polite"></p>
          </div>

          <div>
            <label class="check">
              <input
                id="contacto-privacidad"
                type="checkbox"
                name="privacidad"
                required
                aria-describedby="contacto-privacidad-error"
              />
              <span>
                He leído y acepto la <a class="text-link" href={url('/privacidad')}>política de privacidad</a>.
              </span>
            </label>
            <p class="field__error" id="contacto-privacidad-error" aria-live="polite"></p>
          </div>

          <div class="contacto__submit">
            <button class="btn btn--primary" type="submit">
              Cuéntame tu reforma
              <Icon name="arrow" />
            </button>
            <p class="contacto__safe">
              Sin compromiso. Reviso tu caso personalmente. O escribe a{' '}
              <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
            </p>
          </div>

          <!-- Primera capa de información de privacidad (RGPD). Revisar con quien redacte los textos legales. -->
          <p class="contacto__legal">
            [Primera capa de privacidad: responsable, finalidad (valorar tu consulta y responderte,
            también por WhatsApp), legitimación y derechos. Pendiente de revisión legal.]
          </p>
        </div>

        <!-- Confirmación: sustituye a los campos al enviar y recibe el foco para que se anuncie -->
        <div class="contacto__done" data-contacto-done hidden>
          <Isotipo class="contacto__done-mark" />
          <p class="contacto__done-title" tabindex="-1" data-contacto-done-title></p>
          <p class="contacto__done-text" data-contacto-done-text></p>
          <button class="btn btn--primary" type="button" data-contacto-close>Cerrar</button>
        </div>
      </form>
    </div>
  </div>
</dialog>

<script>
  import { site } from '../data/site';

  const dialog = document.querySelector<HTMLDialogElement>('[data-contacto-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-contacto-form]');

  if (dialog && form) {
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
    const done = form.querySelector<HTMLElement>('[data-contacto-done]');
    const doneTitle = form.querySelector<HTMLElement>('[data-contacto-done-title]');
    const doneText = form.querySelector<HTMLElement>('[data-contacto-done-text]');
    const fieldset = form.querySelector<HTMLElement>('.contacto__fields');
    let trigger: HTMLElement | null = null;

    // ---------- Abrir y cerrar ----------

    const open = (from: HTMLElement | null) => {
      trigger = from;
      // Si se envió antes, la ventana vuelve a mostrar el formulario vacío
      if (done && !done.hidden) {
        done.hidden = true;
        fieldset?.removeAttribute('hidden');
      }
      dialog.showModal();
      window.lenis?.stop();
      // El foco empieza en el título: el lector de pantalla lo lee y el tabulador sigue al formulario
      dialog.querySelector<HTMLElement>('#contacto-title')?.focus();
    };

    // Al cerrar, la ventana baja y se desvanece con el fondo antes de cerrarse de verdad
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const OUT = 320; // lo que dura contacto-out
    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reduceMotion) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(() => {
        dialog.classList.remove('is-closing');
        dialog.close();
      }, OUT);
    };

    // Escape también cierra con la animación (si el navegador deja retener el cierre)
    dialog.addEventListener('cancel', (e) => {
      if (!e.cancelable) return;
      e.preventDefault();
      close();
    });

    dialog.addEventListener('close', () => {
      window.lenis?.start();
      trigger?.focus();
    });

    // Los botones con data-contacto abren la ventana en lugar del email
    document.querySelectorAll<HTMLAnchorElement>('[data-contacto]').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(link);
      });
    });

    dialog.querySelectorAll('[data-contacto-close]').forEach((btn) => btn.addEventListener('click', close));

    // Un clic en el fondo oscuro (fuera de la ventana) también la cierra
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    // ---------- Validación accesible (WCAG 3.3.1 y 3.3.3) ----------

    const message = (input: HTMLInputElement | HTMLTextAreaElement) => {
      const value = input.value.trim();
      switch (input.name) {
        case 'nombre':
          return value ? '' : 'Escribe tu nombre.';
        case 'email':
          if (!value) return 'Escribe tu email.';
          return input.validity.typeMismatch ? 'Revisa el email: debe tener el formato nombre@dominio.com.' : '';
        case 'telefono':
          if (!value) return 'Escribe tu teléfono.';
          return value.replace(/\D/g, '').length < 9
            ? 'Revisa el teléfono: escribe al menos 9 cifras, por ejemplo 612 345 678.'
            : '';
        case 'mensaje':
          return value ? '' : 'Cuéntame qué quieres reformar y dónde está la vivienda.';
        case 'privacidad':
          return (input as HTMLInputElement).checked
            ? ''
            : 'Para responderte necesito que aceptes la política de privacidad.';
        default:
          return '';
      }
    };

    const check = (input: HTMLInputElement | HTMLTextAreaElement) => {
      const msg = message(input);
      const errorId = (input.getAttribute('aria-describedby') ?? '').split(' ').find((id) => id.endsWith('-error'));
      const error = errorId ? document.getElementById(errorId) : null;
      if (error) error.textContent = msg;
      if (msg) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
      return !msg;
    };

    for (const input of fields) {
      // Se valida al salir del campo y se corrige en cuanto el error desaparece
      input.addEventListener('blur', () => {
        if (input.value || input.hasAttribute('aria-invalid')) check(input);
      });
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) check(input);
      });
      input.addEventListener('change', () => {
        if (input.type === 'checkbox') check(input);
      });
    }

    // ---------- Envío ----------

    const showDone = (title: string, text: string) => {
      if (!done || !doneTitle || !doneText) return;
      doneTitle.textContent = title;
      doneText.textContent = text;
      fieldset?.setAttribute('hidden', '');
      done.hidden = false;
      doneTitle.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((input) => !check(input));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const nombre = String(data.get('nombre')).trim();
      const gracias = `Gracias, ${nombre}.`;

      // Con servicio de formularios: se envía sin salir de la página
      if (site.contactoAction) {
        try {
          const res = await fetch(site.contactoAction, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error(String(res.status));
          form.reset();
          showDone(gracias, 'He recibido tu mensaje. Reviso tu caso y te respondo personalmente.');
        } catch {
          showDone(
            'No se ha podido enviar.',
            `Vuelve a intentarlo en un momento o escríbeme directamente a ${site.email}.`,
          );
        }
        return;
      }

      // Sin servicio: se abre el correo con el mensaje ya redactado
      const body = [
        `Nombre: ${nombre}`,
        `Email: ${String(data.get('email')).trim()}`,
        `Teléfono: ${String(data.get('telefono')).trim()}`,
        '',
        String(data.get('mensaje')).trim(),
      ].join('\n');
      const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Mi reforma · ${nombre}`)}&body=${encodeURIComponent(body)}`;
      window.open(mailto, '_self');
      form.reset();
      showDone(gracias, 'Se ha abierto tu correo con el mensaje preparado: solo falta enviarlo.');
    });
  }
</script>

<style>
  /* ---------- Ventana ---------- */

  .contacto {
    width: min(1180px, 100% - 48px);
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 48px 120px -40px rgba(14, 32, 27, 0.55);
    overflow: hidden;
  }

  .contacto[open] {
    display: flex;
  }

  .contacto::backdrop {
    background: rgba(14, 32, 27, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* Dark UI: fondo negro, sin verde */
  :global([data-theme='dark']) .contacto::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }

  :global([data-theme='dark']) .contacto {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 48px 120px -40px rgba(0, 0, 0, 0.8);
  }

  /* La página de detrás no se desplaza mientras la ventana está abierta */
  :global(html:has(.contacto[open])) {
    overflow: hidden;
  }

  /* El contenido se desplaza dentro; el botón de cerrar queda fijo en la esquina */
  .contacto__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(40px, 5vw, 72px) clamp(24px, 5vw, 72px);
  }

  .contacto__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .contacto__close :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .contacto__close:hover {
      background: var(--ink);
      color: var(--bg);
    }
  }

  /* Entrada: sube y aparece; el fondo se oscurece a la vez */
  @media (prefers-reduced-motion: no-preference) {
    .contacto[open] {
      animation: contacto-in 0.55s var(--ease);
    }
    .contacto[open]::backdrop {
      animation: contacto-fondo 0.4s var(--ease);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .contacto.is-closing {
      animation: contacto-out 0.32s var(--ease-in-out) forwards;
      pointer-events: none;
    }
    .contacto.is-closing::backdrop {
      animation: contacto-fondo-out 0.32s var(--ease-in-out) forwards;
    }
  }

  @keyframes contacto-out {
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.985);
    }
  }

  @keyframes contacto-fondo-out {
    to {
      opacity: 0;
    }
  }

  @keyframes contacto-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @keyframes contacto-fondo {
    from {
      opacity: 0;
    }
  }

  /* ---------- Contenido ---------- */

  .contacto__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .contacto__copy {
    display: grid;
    gap: clamp(28px, 3vw, 44px);
    justify-items: start;
  }

  /* Corte natural, sin equilibrar: «Cuéntame tu / reforma» */
  .contacto .contacto__title {
    margin: 0;
    margin-top: -8px;
    font-size: clamp(2.5rem, 5.4vw, 4.4rem);
    text-wrap: wrap;
  }

  /* Fuera de <main> el rótulo no lleva número: solo el filete, en dorado */
  .contacto .eyebrow::before {
    background: var(--gold-line);
  }

  .contacto__title:focus {
    outline: none;
  }

  /* Cita de Andrea con filete dorado y firma */
  .contacto__quote {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 2px 0 2px clamp(18px, 2vw, 24px);
    border-left: 2px solid var(--gold-line);
  }

  .contacto__quote blockquote {
    margin: 0;
  }

  .contacto__quote p {
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.3vw, 1.9rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--number);
    text-wrap: pretty;
  }

  .contacto__quote figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contacto__quote :global(.contacto__mark) {
    flex-shrink: 0;
    width: 28px;
  }

  /* ---------- Formulario: tarjeta de bruma con campos de línea fina ---------- */

  .contacto__form {
    padding: clamp(28px, 3.4vw, 44px);
    border-radius: var(--radius-lg);
  }

  .contacto__fields {
    display: grid;
    gap: 26px;
  }

  .contacto__fields[hidden] {
    display: none;
  }

  .contacto__req {
    font-size: 0.875rem;
    color: var(--text);
  }

  .contacto__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
  }

  .field label {
    margin-bottom: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 4px 0;
    border: 0;
    border-bottom: 1px solid var(--line-ui); /* ≥3:1, WCAG 1.4.11 */
    border-radius: 0;
    background: transparent;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-size: 0% 2px;
    background-position: left bottom;
    background-repeat: no-repeat;
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--text);
    transition: background-size var(--t-color) var(--ease);
  }

  .field input {
    height: 44px;
  }

  .field textarea {
    min-height: 116px;
    resize: vertical;
    line-height: 1.5;
  }

  /* Foco: la línea inferior se dibuja en tinta (2 px) */
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background-size: 100% 2px;
  }

  /* Colores forzados (Windows): el fondo de la línea de foco desaparece, así que vuelve el contorno */
  @media (forced-colors: active) {
    .field input:focus-visible,
    .field textarea:focus-visible {
      outline: 2px solid Highlight;
      outline-offset: 2px;
    }
  }

  .field__hint {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Campo con error: línea y mensaje en el color de error (con texto, no solo color) */
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-bottom-color: var(--error);
    background-image: linear-gradient(var(--error), var(--error));
  }

  /* Vacío no ocupa sitio, pero sigue en el árbol de accesibilidad (una región en vivo con
     display: none no anuncia lo que se le escribe después) */
  .field__error {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--error);
  }

  .field__error:not(:empty) {
    margin-top: 8px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text);
  }

  /* Casilla propia: igual en modo día y noche, borde ≥3:1 (WCAG 1.4.11) */
  .check input {
    appearance: none;
    -webkit-appearance: none;
    display: grid;
    place-content: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin: 0;
    border: 1px solid var(--line-ui);
    border-radius: 3px;
    background: var(--surface);
    cursor: pointer;
    transition:
      background-color var(--t-color) var(--ease),
      border-color var(--t-color) var(--ease);
  }

  .check input::after {
    content: '';
    width: 12px;
    height: 6px;
    margin-top: -3px;
    border-left: 2px solid var(--bg);
    border-bottom: 2px solid var(--bg);
    transform: rotate(-45deg) scale(0);
    transition: transform var(--t-move) var(--ease);
  }

  .check input:checked {
    border-color: var(--ink);
    background: var(--ink);
  }

  .check input:checked::after {
    transform: rotate(-45deg) scale(1);
  }

  .check input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .contacto__submit {
    display: grid;
    gap: 16px;
  }

  .contacto__form .btn {
    width: 100%;
  }

  .contacto__safe {
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    font-weight: 300;
    line-height: 1.55;
    color: var(--text);
  }

  /* Letra pequeña separada por un filete */
  .contacto__legal {
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* ---------- Confirmación ---------- */

  .contacto__done {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: 12px 0 4px;
  }

  .contacto__done[hidden] {
    display: none;
  }

  .contacto__done :global(.contacto__done-mark) {
    width: 36px;
    margin-bottom: 6px;
  }

  .contacto__done-title {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 300;
    line-height: 1.15;
  }

  .contacto__done-title:focus {
    outline: none;
  }

  .contacto__done-text {
    max-width: 40ch;
    color: var(--muted);
  }

  .contacto__done .btn {
    width: auto;
    margin-top: 10px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contacto__close,
    .field input,
    .field textarea,
    .check input,
    .check input::after {
      transition: none;
    }
  }

  /* ---------- Tablet y móvil ---------- */

  @media (max-width: 900px) {
    .contacto__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* En el móvil la ventana ocupa toda la pantalla */
  @media (max-width: 640px) {
    .contacto {
      width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border-radius: 0;
    }
    .contacto__scroll {
      padding: 72px var(--gutter) 40px;
    }
    .contacto__close {
      top: 12px;
      right: 12px;
    }
    .contacto__pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
