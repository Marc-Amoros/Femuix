---
import Icon from './Icon.astro';
import Isotipo from './Isotipo.astro';
import { site, url } from '../data/site';
import { filtro, perfil, type Pregunta } from '../data/formulario';

// Pantallas 2 y 3: se pintan desde las preguntas de src/data/formulario.ts
const pantallas = [
  {
    n: 2,
    titulo: 'Tu vivienda',
    intro: 'Cuatro preguntas para saber si puedo ayudarte.',
    preguntas: filtro,
    boton: 'Continuar',
    volver: 'Volver a tus datos',
  },
  {
    n: 3,
    titulo: 'Último paso',
    intro: 'Cinco preguntas para preparar nuestra conversación. Las dos últimas son opcionales.',
    preguntas: perfil,
    boton: 'Enviar mi reforma',
    volver: 'Volver a tu vivienda',
  },
];

const campo = (p: Pregunta) => `contacto-${p.nombre}`;
const describe = (...ids: (string | false | undefined)[]) => ids.filter(Boolean).join(' ') || undefined;
---

<!-- «Cuéntame tu reforma»: ventana con el formulario de contacto. La abren los botones con
     data-contacto; sin JavaScript esos botones abren el email. <dialog> en modo modal ya atrapa
     el foco, se cierra con Escape y deja inerte el resto de la página.
     Tres pantallas: tus datos, tu vivienda (filtra) y último paso (perfila). Quien no encaja
     sale en la pantalla 2 con una despedida y el motivo; todo llega a «Consultas» (contactoAction). -->
<dialog class="contacto" aria-labelledby="contacto-title" data-contacto-dialog data-lenis-prevent>
  <button class="contacto__close" type="button" aria-label="Cerrar" data-contacto-close>
    <Icon name="close" />
  </button>

  <div class="contacto__scroll">
    <div class="contacto__copy">
      <span class="eyebrow">Empieza aquí</span>
      <h2 id="contacto-title" class="h-display contacto__title" tabindex="-1">
        Cuéntame <em>tu reforma</em>
      </h2>
    </div>

    <form
      class="contacto__form band tex-none"
      method="post"
      action={site.contactoAction || undefined}
      aria-labelledby="contacto-title"
      novalidate
      data-contacto-form
      data-paso-actual="1"
    >
      <!-- Lo que no escribe la persona: el resultado del filtro y de dónde llega -->
      <input type="hidden" name="encaje" />
      <input type="hidden" name="estado" />
      <input type="hidden" name="motivo" />
      <input type="hidden" name="procedencia" />

      <div class="contacto__fields">
        <div class="contacto__top">
          <p class="contacto__req">Tres pasos · menos de 3 minutos</p>
          <!-- Progreso: decorativo; el paso en que estás lo dice el título de cada pantalla -->
          <div class="pasos" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>

        <!-- Pantalla 1 · Tus datos. Los avisos son regiones en vivo, siempre presentes: se anuncian
             al rellenarse (WCAG 4.1.3) -->
        <div class="paso" data-paso>
          <h3 class="paso__title" tabindex="-1" data-paso-title>
            <span class="paso__n">Paso 1 de 3</span>{' '}
            Tus datos
          </h3>

          <div class="field">
            <label for="contacto-nombre">Nombre</label>
            <input
              id="contacto-nombre"
              name="nombre"
              type="text"
              autocomplete="name"
              required
              aria-describedby="contacto-nombre-error"
            />
            <p class="field__error" id="contacto-nombre-error" aria-live="polite"></p>
          </div>

          <div class="contacto__pair">
            <div class="field">
              <label for="contacto-email">Email</label>
              <input
                id="contacto-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                aria-describedby="contacto-email-error"
              />
              <p class="field__error" id="contacto-email-error" aria-live="polite"></p>
            </div>

            <div class="field">
              <label for="contacto-telefono">Móvil</label>
              <input
                id="contacto-telefono"
                name="telefono"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                required
                aria-describedby="contacto-telefono-hint contacto-telefono-error"
              />
              <p class="field__hint" id="contacto-telefono-hint">Te escribo por WhatsApp.</p>
              <p class="field__error" id="contacto-telefono-error" aria-live="polite"></p>
            </div>
          </div>

          <div>
            <label class="check">
              <input
                id="contacto-privacidad"
                type="checkbox"
                name="privacidad"
                required
                aria-describedby="contacto-privacidad-error"
              />
              <span>
                He leído y acepto la <a class="text-link" href={url('/privacidad')}>política de privacidad</a>.
              </span>
            </label>
            <p class="field__error" id="contacto-privacidad-error" aria-live="polite"></p>
          </div>

          <div class="contacto__submit">
            <button class="btn btn--primary" type="submit">
              Continuar
              <Icon name="arrow" />
            </button>
            <p class="contacto__safe">Sin compromiso. Uso tus datos solo para responderte.</p>
          </div>

          <!-- Primera capa de información de privacidad (RGPD). Revisar con quien redacte los textos legales. -->
          <p class="contacto__legal">
            [Primera capa de privacidad: responsable, finalidad (valorar tu consulta y responderte,
            también por WhatsApp), legitimación y derechos. Pendiente de revisión legal.]
          </p>
        </div>

        {
          pantallas.map((pantalla) => (
            <div class="paso" data-paso hidden>
              <div class="paso__head">
                <h3 class="paso__title" tabindex="-1" data-paso-title>
                  <span class="paso__n">Paso {pantalla.n} de 3</span>{' '}
                  {pantalla.titulo}
                </h3>
                <p class="paso__intro">{pantalla.intro}</p>
              </div>

              {pantalla.preguntas.map((p) =>
                p.tipo === 'opciones' ? (
                  <fieldset class="choice" aria-describedby={`${campo(p)}-error`}>
                    <legend>{p.etiqueta}</legend>
                    <div class="choice__options">
                      {p.opciones?.map((o) => (
                        <label class="choice__opt">
                          <input type="radio" name={p.nombre} value={o.valor} required={p.obligatoria} />
                          <span>{o.valor}</span>
                        </label>
                      ))}
                    </div>
                    <p class="field__error" id={`${campo(p)}-error`} aria-live="polite"></p>
                  </fieldset>
                ) : p.tipo === 'lista' ? (
                  <div class="field">
                    <label for={campo(p)}>
                      {p.etiqueta}
                      {!p.obligatoria && <span class="field__opt"> (opcional)</span>}
                    </label>
                    <select
                      id={campo(p)}
                      name={p.nombre}
                      required={p.obligatoria}
                      aria-describedby={describe(p.obligatoria && `${campo(p)}-error`)}
                    >
                      <option value="">Elige una opción</option>
                      {p.opciones?.map((o) => (
                        <option value={o.valor}>{o.valor}</option>
                      ))}
                    </select>
                    {p.obligatoria && <p class="field__error" id={`${campo(p)}-error`} aria-live="polite"></p>}
                  </div>
                ) : (
                  <div class="field">
                    <label for={campo(p)}>{p.etiqueta}</label>
                    <textarea
                      id={campo(p)}
                      name={p.nombre}
                      rows="2"
                      required={p.obligatoria}
                      aria-describedby={describe(p.ayuda && `${campo(p)}-hint`, p.obligatoria && `${campo(p)}-error`)}
                    ></textarea>
                    {p.ayuda && (
                      <p class="field__hint" id={`${campo(p)}-hint`}>
                        {p.ayuda}
                      </p>
                    )}
                    {p.obligatoria && <p class="field__error" id={`${campo(p)}-error`} aria-live="polite"></p>}
                  </div>
                ),
              )}

              <div class="contacto__submit">
                <button class="btn btn--primary" type="submit">
                  {pantalla.boton}
                  <Icon name="arrow" />
                </button>
                <button class="paso__back" type="button" data-paso-back>
                  <Icon name="arrow" />
                  {pantalla.volver}
                </button>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Pantalla A (gracias) o B (despedida): sustituye a los campos y recibe el foco para que se anuncie -->
      <div class="contacto__done" data-contacto-done hidden>
        <Isotipo class="contacto__done-mark" />
        <p class="contacto__done-title" tabindex="-1" data-contacto-done-title></p>
        <p class="contacto__done-text" data-contacto-done-text></p>
        <p class="contacto__done-note" data-contacto-done-note hidden>
          ¿Me he equivocado al entenderte? Escríbeme a{' '}
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <button class="btn btn--primary" type="button" data-contacto-close>Cerrar</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { site } from '../data/site';
  import { encajeDe, filtro, perfil } from '../data/formulario';

  const dialog = document.querySelector<HTMLDialogElement>('[data-contacto-dialog]');
  const form = dialog?.querySelector<HTMLFormElement>('[data-contacto-form]');

  if (dialog && form) {
    type Control = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
    const steps = [...form.querySelectorAll<HTMLElement>('[data-paso]')];
    const done = form.querySelector<HTMLElement>('[data-contacto-done]');
    const doneTitle = form.querySelector<HTMLElement>('[data-contacto-done-title]');
    const doneText = form.querySelector<HTMLElement>('[data-contacto-done-text]');
    const doneNote = form.querySelector<HTMLElement>('[data-contacto-done-note]');
    const fieldset = form.querySelector<HTMLElement>('.contacto__fields');
    const preguntas = Object.fromEntries([...filtro, ...perfil].map((p) => [p.nombre, p]));
    let trigger: HTMLElement | null = null;

    // De dónde llega la visita, para medir por canal: la campaña del enlace (?utm_source=instagram),
    // si no la web de la que viene y, si no, «directo»
    const procedencia = (() => {
      const utm = new URLSearchParams(location.search).get('utm_source');
      if (utm) return utm;
      try {
        const ref = document.referrer ? new URL(document.referrer).hostname : '';
        return ref && ref !== location.hostname ? ref : 'directo';
      } catch {
        return 'directo';
      }
    })();

    // ---------- Abrir y cerrar ----------

    const open = (from: HTMLElement | null) => {
      trigger = from;
      // Si se envió antes, la ventana vuelve a mostrar el formulario vacío, desde el primer paso.
      // Si se cerró a medias, lo escrito se conserva y se sigue donde se dejó
      if (done && !done.hidden) {
        done.hidden = true;
        fieldset?.removeAttribute('hidden');
        goTo(0, false);
      }
      dialog.showModal();
      window.lenis?.stop();
      // El foco empieza en el título: el lector de pantalla lo lee y el tabulador sigue al formulario
      dialog.querySelector<HTMLElement>('#contacto-title')?.focus();
    };

    // Al cerrar, la ventana baja y se desvanece con el fondo antes de cerrarse de verdad
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const OUT = 320; // lo que dura contacto-out
    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reduceMotion) {
        dialog.close();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(() => {
        dialog.classList.remove('is-closing');
        dialog.close();
      }, OUT);
    };

    // Escape también cierra con la animación (si el navegador deja retener el cierre)
    dialog.addEventListener('cancel', (e) => {
      if (!e.cancelable) return;
      e.preventDefault();
      close();
    });

    dialog.addEventListener('close', () => {
      window.lenis?.start();
      trigger?.focus();
    });

    // Los botones con data-contacto abren la ventana en lugar del email
    document.querySelectorAll<HTMLAnchorElement>('[data-contacto]').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', (e) => {
        e.preventDefault();
        open(link);
      });
    });

    dialog.querySelectorAll('[data-contacto-close]').forEach((btn) => btn.addEventListener('click', close));

    // Un clic en el fondo oscuro (fuera de la ventana) también la cierra
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    // ---------- Validación accesible (WCAG 3.3.1 y 3.3.3) ----------
    // Se valida por nombre de campo: un grupo de opciones (radio) cuenta como un solo campo

    const inputsOf = (name: string) => [...form.querySelectorAll<Control>(`[name="${name}"]`)];

    const valueOf = (name: string) => {
      const inputs = inputsOf(name);
      const first = inputs[0];
      if (first instanceof HTMLInputElement && first.type === 'radio') {
        return inputs.find((i) => (i as HTMLInputElement).checked)?.value ?? '';
      }
      if (first instanceof HTMLInputElement && first.type === 'checkbox') return first.checked ? 'sí' : '';
      return first?.value.trim() ?? '';
    };

    const message = (name: string) => {
      const value = valueOf(name);
      const pregunta = preguntas[name];
      if (pregunta) return pregunta.obligatoria && !value ? (pregunta.error ?? '') : '';
      switch (name) {
        case 'nombre':
          return value ? '' : 'Escribe tu nombre.';
        case 'email':
          if (!value) return 'Escribe tu email.';
          return (inputsOf(name)[0] as HTMLInputElement).validity.typeMismatch
            ? 'Revisa el email: debe tener el formato nombre@dominio.com.'
            : '';
        case 'telefono':
          if (!value) return 'Escribe tu móvil.';
          return value.replace(/\D/g, '').length < 9
            ? 'Revisa el móvil: escribe al menos 9 cifras, por ejemplo 612 345 678.'
            : '';
        case 'privacidad':
          return value ? '' : 'Para responderte necesito que aceptes la política de privacidad.';
        default:
          return '';
      }
    };

    const check = (name: string) => {
      const msg = message(name);
      const error = document.getElementById(`contacto-${name}-error`);
      if (error) error.textContent = msg;
      for (const input of inputsOf(name)) {
        if (msg) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
      return !msg;
    };

    // El foco va al campo con error; en un grupo de opciones, a la elegida o a la primera
    const focusField = (name: string) => {
      const inputs = inputsOf(name);
      (inputs.find((i) => (i as HTMLInputElement).checked) ?? inputs[0])?.focus();
    };

    const namesIn = (scope: Element) => [
      ...new Set([...scope.querySelectorAll<Control>('[required]')].map((input) => input.name)),
    ];

    for (const input of form.querySelectorAll<Control>('[required]')) {
      // Se valida al salir del campo y se corrige en cuanto el error desaparece; una opción, al elegirla
      input.addEventListener('blur', () => {
        if (input.type !== 'radio' && (input.value || input.hasAttribute('aria-invalid'))) check(input.name);
      });
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) check(input.name);
      });
      input.addEventListener('change', () => {
        if (input.type === 'checkbox' || input.type === 'radio' || input instanceof HTMLSelectElement) {
          check(input.name);
        }
      });
    }

    // ---------- Pasos ----------

    let step = 0;

    // Al cambiar de paso, el foco va a su título («Paso 2 de 3, Tu vivienda») para que el
    // lector de pantalla lo anuncie y el tabulador siga desde ahí
    function goTo(n: number, focus = true) {
      step = n;
      steps.forEach((el, i) => (el.hidden = i !== n));
      form!.dataset.pasoActual = String(n + 1);
      if (focus) steps[n].querySelector<HTMLElement>('[data-paso-title]')?.focus();
    }

    form.querySelectorAll('[data-paso-back]').forEach((btn) => btn.addEventListener('click', () => goTo(step - 1)));

    // ---------- Pantallas A y B, y envío a Consultas ----------

    const showDone = (title: string, text: string, note = false) => {
      if (!done || !doneTitle || !doneText) return;
      doneTitle.textContent = title;
      doneText.textContent = text;
      if (doneNote) doneNote.hidden = !note;
      fieldset?.setAttribute('hidden', '');
      done.hidden = false;
      doneTitle.focus();
      // reset() no vacía los campos ocultos a los que se ha dado valor: se vacían a mano
      form.reset();
      form.querySelectorAll<HTMLInputElement>('input[type="hidden"]').forEach((input) => (input.value = ''));
      goTo(0, false);
    };

    const setHidden = (name: string, value: string) => {
      const input = form.querySelector<HTMLInputElement>(`input[type="hidden"][name="${name}"]`);
      if (input) input.value = value;
    };

    const respuestasFiltro = () => Object.fromEntries(filtro.map((p) => [p.nombre, valueOf(p.nombre)]));

    // Envía todo el formulario al servicio que lo pasa a Consultas (Notion). Sin servicio, no hay envío
    const enviar = async () => {
      if (!site.contactoAction) return false;
      setHidden('procedencia', procedencia);
      try {
        const res = await fetch(site.contactoAction, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        return res.ok;
      } catch {
        return false;
      }
    };

    // Pantalla 1 → 2; pantalla 2 → despedida (si algo descarta) o 3; pantalla 3 → gracias
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = namesIn(steps[step]).filter((name) => !check(name));
      if (invalid.length) {
        focusField(invalid[0]);
        return;
      }
      if (step === 0) {
        goTo(1);
        return;
      }

      const nombre = valueOf('nombre');
      const { encaje, motivos } = encajeDe(respuestasFiltro());
      setHidden('encaje', encaje);

      // Pantalla B · Despedida: llega igual a Consultas, como «No encaja» (estado Descartada)
      if (step === 1 && encaje === 'No encaja') {
        setHidden('estado', 'Descartada');
        setHidden('motivo', motivos.join(' '));
        await enviar();
        showDone(
          `Gracias, ${nombre}.`,
          `${motivos[0]} Por eso, esta vez no puedo acompañarte, y prefiero decírtelo claro. Te deseo mucha suerte con tu reforma.`,
          true,
        );
        return;
      }
      if (step === 1) {
        goTo(2);
        return;
      }

      // Pantalla A · Gracias: «Encaja» o «Dudoso», estado Nueva
      setHidden('estado', 'Nueva');
      setHidden('motivo', '');
      const movil = valueOf('telefono');
      const gracias = `Gracias, ${nombre}.`;

      if (site.contactoAction) {
        if (await enviar()) {
          showDone(gracias, `He recibido tu reforma. La leo yo y te escribo por WhatsApp al ${movil}.`);
        } else {
          if (!done || !doneTitle || !doneText) return;
          doneTitle.textContent = 'No se ha podido enviar.';
          doneText.textContent = `Vuelve a intentarlo en un momento o escríbeme directamente a ${site.email}.`;
          if (doneNote) doneNote.hidden = true;
          fieldset?.setAttribute('hidden', '');
          done.hidden = false;
          doneTitle.focus();
        }
        return;
      }

      // Sin servicio: se abre el correo con el mensaje ya redactado
      const body = [
        ...[...filtro, ...perfil].map((p) => `${p.etiqueta.replace(/^¿|\?$/g, '')}: ${valueOf(p.nombre) || '—'}`),
        '',
        `Nombre: ${nombre}`,
        `Email: ${valueOf('email')}`,
        `Móvil: ${movil}`,
        `Encaje: ${encaje}`,
      ].join('\n');
      const mailto = `mailto:${site.email}?subject=${encodeURIComponent(`Mi reforma · ${nombre}`)}&body=${encodeURIComponent(body)}`;
      window.open(mailto, '_self');
      showDone(
        gracias,
        `Se ha abierto tu correo con el mensaje preparado: solo falta enviarlo. Después, te escribo por WhatsApp al ${movil}.`,
      );
    });
  }
</script>

<style>
  /* ---------- Ventana ---------- */

  .contacto {
    width: min(680px, 100% - 48px);
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius-lg) + 6px);
    background: var(--bg);
    color: var(--text);
    box-shadow: 0 48px 120px -40px rgba(14, 32, 27, 0.55);
    overflow: hidden;
  }

  .contacto[open] {
    display: flex;
  }

  .contacto::backdrop {
    background: rgba(14, 32, 27, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* Dark UI: fondo negro, sin verde */
  :global([data-theme='dark']) .contacto::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }

  :global([data-theme='dark']) .contacto {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 48px 120px -40px rgba(0, 0, 0, 0.8);
  }

  /* La página de detrás no se desplaza mientras la ventana está abierta */
  :global(html:has(.contacto[open])) {
    overflow: hidden;
  }

  /* El contenido se desplaza dentro; el botón de cerrar queda fijo en la esquina */
  .contacto__scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(28px, 3.5vw, 48px) clamp(20px, 3.5vw, 48px);
  }

  .contacto__close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .contacto__close :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (hover: hover) {
    .contacto__close:hover {
      background: var(--ink);
      color: var(--bg);
    }
  }

  /* Entrada: sube y aparece; el fondo se oscurece a la vez */
  @media (prefers-reduced-motion: no-preference) {
    .contacto[open] {
      animation: contacto-in 0.55s var(--ease);
    }
    .contacto[open]::backdrop {
      animation: contacto-fondo 0.4s var(--ease);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .contacto.is-closing {
      animation: contacto-out 0.32s var(--ease-in-out) forwards;
      pointer-events: none;
    }
    .contacto.is-closing::backdrop {
      animation: contacto-fondo-out 0.32s var(--ease-in-out) forwards;
    }
  }

  @keyframes contacto-out {
    to {
      opacity: 0;
      transform: translateY(16px) scale(0.985);
    }
  }

  @keyframes contacto-fondo-out {
    to {
      opacity: 0;
    }
  }

  @keyframes contacto-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @keyframes contacto-fondo {
    from {
      opacity: 0;
    }
  }

  /* ---------- Contenido ---------- */

