---
// Símbolo de Femuix con sus colores originales: no se recolorea.
// tone="dark"  → Simbolo verde.svg (fondos claros, siempre)
// tone="auto"  → verde en White; gris de FEMUIX black 2.svg en Dark UI
// tone="light" → Simbolo negativo.svg sobre verde en White; gris de black 2 en Dark UI
// (se alterna por CSS con .only-light / .only-dark en global.css)
// El dibujo no va aquí: está una sola vez por página en IsotipoSprite.astro (en Base.astro) y este
// componente lo referencia, así 16 copias no repiten 3,5 KB de trazos cada una.
interface Props {
  tone?: 'dark' | 'light' | 'auto';
  class?: string;
}

const { tone = 'auto', class: className } = Astro.props;
---

<svg class={className} viewBox="-4 -4 178 178" aria-hidden="true">
  {
    tone === 'dark' ? (
      <use href="#isotipo-verde" />
    ) : (
      <>
        <use href={tone === 'light' ? '#isotipo-negativo' : '#isotipo-verde'} class="only-light" />
        <use href="#isotipo-gris" class="only-dark" />
      </>
    )
  }
</svg>
