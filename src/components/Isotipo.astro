---
// Símbolo de Femuix con sus colores originales: no se recolorea.
// tone="dark"  → Simbolo verde.svg (fondos claros, siempre)
// tone="auto"  → verde en White; gris de FEMUIX black 2.svg en Dark UI
// tone="light" → Simbolo negativo.svg sobre verde en White; gris de black 2 en Dark UI
// (se alterna por CSS con .only-light / .only-dark en global.css)
interface Props {
  tone?: 'dark' | 'light' | 'auto';
  class?: string;
}

const { tone = 'auto', class: className } = Astro.props;
