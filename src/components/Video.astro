---
import Placeholder from './Placeholder.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { usarMuestras, video } from '../data/media';
import { site } from '../data/site';

// De qué habla el vídeo: ayuda a decidir si verlo y sirve de índice
const capitulos = ['Para quién trabajo', 'Qué pasa cuando no hay plan', 'Qué hago distinto'];
---

<section class="section band video" data-expand aria-labelledby="video-title">
  <div class="container">
    <div class="video__head">
      <span class="eyebrow reveal">Antes de nada</span>
      <SplitText
        id="video-title"
        class="h-section"
        parts={[{ text: 'Quién soy y por qué esto' }, { text: 'funciona así', em: true }]}
      />
      <p class="lead video__lead reveal">
        Antes de contarte el método, te cuento quién está detrás y por qué trabajo así.
      </p>
    </div>
  </div>

  <!-- El marco crece con el scroll hasta ocupar el ancho completo -->
  <div class="video__stage" data-scrub>
    <!-- Con muestras: vídeo que no se reproduce solo (WCAG 2.2.2), se inicia con el botón.
         Sin muestras: hueco para el vídeo real con subtítulos incrustados (60–90 s). -->
    <div class="video__frame">
      {
        usarMuestras ? (
          <div class="video__player" data-player>
            <video preload="none" poster={video.poster} playsinline aria-label={video.descripcion}>
              <source src={video.src} type="video/mp4" />
            </video>
            <span class="video__corners" aria-hidden="true" />
            <p class="video__caption" aria-hidden="true">
              <span>Andrea · Femuix</span>
              <span>{site.city}</span>
            </p>
            <button class="video__play" type="button" data-play>
              <span class="video__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5.5v13l10.5-6.5z" />
                </svg>
              </span>
              <span class="video__play-text">
                Ver el vídeo
                <span class="video__play-time" data-duration hidden />
              </span>
            </button>
          </div>
        ) : (
      <Placeholder
        label="Vídeo · 60 a 90 segundos"
        note="Con subtítulos incrustados: casi todo el tráfico llega desde el móvil y sin sonido. Cuentas para quién trabajas, qué pasa cuando no hay plan y qué haces tú distinto."
        ratio="16 / 9"
        icon="play"
        tone="dark"
      />
        )
      }
    </div>

    <div class="video__index">
      <h3 class="video__index-title reveal">En el vídeo</h3>
      <ol class="video__chapters">
        {
          capitulos.map((c, i) => (
            <li class="reveal">
              <span class="video__n">0{i + 1}</span>
              {c}
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Alternativa en texto: sin ella el vídeo no es accesible para quien no puede verlo -->
    <details class="video__alt">
      <summary>
        <span>Leer la descripción del vídeo</span>
        <span class="video__alt-icon" aria-hidden="true"><Icon name="plus" /></span>
      </summary>
      <p>{usarMuestras ? video.transcripcion : '[Transcripción del vídeo: lo que se dice y lo que se ve.]'}</p>
    </details>
  </div>
</section>

<script>
  // Al pulsar el botón aparecen los controles del navegador y empieza el vídeo
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const video = player.querySelector('video');
    const play = player.querySelector<HTMLButtonElement>('[data-play]');
    const time = player.querySelector<HTMLElement>('[data-duration]');

    // La duración se lee del propio vídeo para que nunca quede desfasada
    const showDuration = () => {
      if (!video || !time || !Number.isFinite(video.duration)) return;
      const total = Math.round(video.duration);
      time.textContent = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
      time.hidden = false;
    };
    video?.addEventListener('loadedmetadata', showDuration);
    // La duración (metadatos) solo se pide cuando el vídeo se acerca a la pantalla
    if (video) {
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          near.disconnect();
          video.preload = 'metadata';
          video.load();
        },
        { rootMargin: '600px 0px' },
      );
      near.observe(video);
    }

    play?.addEventListener('click', () => {
      if (!video) return;
      video.controls = true;
      player.classList.add('is-playing');
      video.play();
      video.focus();
    });
  });
</script>

<style>
  .video__head {
    display: grid;
    justify-items: center;
    gap: 24px;
    margin-bottom: clamp(56px, 7vw, 96px);
    text-align: center;
  }

  .video__lead {
    max-width: 46ch;
    margin: 0;
  }

  .video__stage {
    --p: 1;
    padding-inline: var(--gutter);
  }

  .video__frame {
    max-width: 1440px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) * (1.6 - var(--p)));
    box-shadow: 0 50px 100px -50px rgba(14, 32, 27, 0.55);
    transform: scale(calc(0.72 + 0.28 * var(--p)));
    transform-origin: center top;
    will-change: transform;
  }

  .video__frame :global(.ph) {
    border-radius: 0;
  }

  /* Índice: de qué habla el vídeo, en una línea con rombos dorados */
  .video__index {
    display: grid;
    justify-items: center;
    gap: 18px;
    max-width: 1080px;
    margin: clamp(40px, 5vw, 64px) auto 0;
    padding-inline: var(--gutter);
  }

  .video__index-title {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .video__chapters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 12px 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .video__chapters li {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--serif);
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--text);
  }

  .video__chapters li + li::before {
    content: '';
    align-self: center;
    width: 6px;
    height: 6px;
    margin-inline: clamp(18px, 2.6vw, 36px);
    background: var(--gold-line);
    transform: rotate(45deg);
  }

  .video__n {
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--number);
  }

  .video__alt {
    max-width: 640px;
    margin: 20px auto 0;
    padding-inline: var(--gutter);
    text-align: center;
  }

  .video__alt summary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    color: var(--text);
  }

  .video__alt summary::-webkit-details-marker {
    display: none;
  }

  .video__alt summary span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--gold-line);
    text-underline-offset: 5px;
  }

  .video__alt-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    transition: transform 0.5s var(--ease);
  }

  .video__alt-icon :global(svg) {
    width: 12px;
    height: 12px;
  }

  .video__alt[open] .video__alt-icon {
    transform: rotate(45deg);
  }

  .video__alt p {
    margin-top: 8px;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .video__player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--deep);
  }

  .video__player video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Esquinas doradas, como el visor de una cámara */
  .video__corners {
    --c: var(--warm);
    --l: clamp(18px, 2.4vw, 32px);
    position: absolute;
    inset: clamp(14px, 2.2vw, 32px);
    pointer-events: none;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) top left / 1px var(--l),
      linear-gradient(var(--c), var(--c)) top right / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) top right / 1px var(--l),
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) bottom left / 1px var(--l),
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) bottom right / 1px var(--l);
    background-repeat: no-repeat;
  }

  /* Pie sobre la imagen, con degradado oscuro para que el texto se lea */
  .video__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: clamp(48px, 7vw, 96px) clamp(32px, 4.4vw, 64px) clamp(28px, 3.6vw, 52px);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.4) 55%, transparent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffffff;
    pointer-events: none;
  }

  /* Botón en píldora: icono + texto visible, más claro que un triángulo solo */
  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 8px 26px 8px 8px;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.55);
    transform: translate(-50%, -50%);
    transition: transform 0.6s var(--ease);
  }

  .video__play:hover {
    transform: translate(-50%, -50%) scale(1.04);
  }

  .video__play-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(52px, 5vw, 64px);
    height: clamp(52px, 5vw, 64px);
    border-radius: 50%;
    background: var(--cta-bg);
    color: var(--cta-fg);
  }

  /* Anillo dorado que late suave alrededor del icono */
  .video__play-icon::after {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--gold-line);
    border-radius: 50%;
    animation: video-pulse 2.6s var(--ease) infinite;
  }

  @keyframes video-pulse {
    0% {
      opacity: 0.9;
      transform: scale(0.92);
    }
    100% {
      opacity: 0;
      transform: scale(1.3);
    }
  }

  .video__play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  .video__play-text {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .video__play-time {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .video__play-time::before {
    content: '·';
    margin-right: 10px;
  }

  .video__player.is-playing .video__corners,
  .video__player.is-playing .video__caption,
  .video__player.is-playing .video__play {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .video__play,
    .video__play:hover {
      transition: none;
      transform: translate(-50%, -50%);
    }
    .video__play-icon::after {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    /* En móvil el marco es pequeño: sin pie y con un botón más compacto */
    .video__caption {
      display: none;
    }
    .video__play {
      gap: 10px;
      padding: 5px 16px 5px 5px;
      font-size: 0.875rem;
    }
    .video__play-icon {
      width: 44px;
      height: 44px;
    }
    .video__play svg {
      width: 18px;
      height: 18px;
    }
    .video__chapters {
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .video__chapters li + li::before {
      display: none;
    }
  }
</style>
