---
import Placeholder from './Placeholder.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { usarMuestras, video } from '../data/media';
import { site } from '../data/site';

// De qué habla el vídeo: ayuda a decidir si verlo y sirve de índice
const capitulos = ['Para quién trabajo', 'Qué pasa cuando no hay plan', 'Qué hago distinto'];
---

<section class="section band video" data-expand aria-labelledby="video-title">
  <div class="container">
    <div class="video__head">
      <span class="eyebrow reveal">Antes de nada</span>
      <SplitText
        id="video-title"
        class="h-section"
        parts={[{ text: 'Quién soy y por qué esto' }, { text: 'funciona así', em: true }]}
      />
      <p class="lead video__lead reveal">
        Antes de contarte el método, te cuento quién está detrás y por qué trabajo así.
      </p>
    </div>
  </div>

  <!-- El marco crece con el scroll hasta ocupar el ancho completo -->
  <div class="video__stage" data-scrub>
    <!-- Con muestras: vídeo que no se reproduce solo (WCAG 2.2.2), se inicia con el botón.
         Sin muestras: hueco para el vídeo real con subtítulos incrustados (60–90 s). -->
    <div class="video__frame">
      {
        usarMuestras ? (
          <div class="video__player" data-player>
            <video preload="none" poster={video.poster} playsinline aria-label={video.descripcion}>
              <source src={video.src} type="video/mp4" />
            </video>
            <span class="video__corners" aria-hidden="true" />
            <p class="video__caption" aria-hidden="true">
              <span>Andrea · Femuix</span>
              <span>{site.city}</span>
            </p>
            <button class="video__play" type="button" data-play>
              <span class="video__play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5.5v13l10.5-6.5z" />
                </svg>
              </span>
              <span class="video__play-text">
                Ver el vídeo
                <span class="video__play-time" data-duration hidden />
              </span>
            </button>
          </div>
        ) : (
      <Placeholder
        label="Vídeo · 60 a 90 segundos"
        note="Con subtítulos incrustados: casi todo el tráfico llega desde el móvil y sin sonido. Cuentas para quién trabajas, qué pasa cuando no hay plan y qué haces tú distinto."
        ratio="16 / 9"
        icon="play"
        tone="dark"
      />
        )
      }
    </div>

    <!-- Panel bajo el vídeo: de qué habla y, al pie, su descripción en texto (WCAG 1.2.1) -->
    <div class="vpanel reveal">
      <p class="vpanel__kicker">En el vídeo</p>
      <ol class="vpanel__chapters">
        {
          capitulos.map((c, i) => (
            <li>
              <span class="vpanel__n">0{i + 1}</span>
              <span class="vpanel__t">{c}</span>
            </li>
          ))
        }
      </ol>

      <details class="vpanel__alt">
        <summary>
          <span class="vpanel__alt-title">Descripción del vídeo</span>
          <span class="vpanel__alt-action">
            <span class="vpanel__alt-open">Leer</span>
            <span class="vpanel__alt-close">Ocultar</span>
            <span class="vpanel__alt-icon" aria-hidden="true"><Icon name="plus" /></span>
          </span>
        </summary>
        <p class="vpanel__alt-text">
          {usarMuestras ? video.transcripcion : '[Transcripción del vídeo: lo que se dice y lo que se ve.]'}
        </p>
      </details>
    </div>
  </div>
</section>

<script>
  // Al pulsar el botón aparecen los controles del navegador y empieza el vídeo
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
    const video = player.querySelector('video');
    const play = player.querySelector<HTMLButtonElement>('[data-play]');
    const time = player.querySelector<HTMLElement>('[data-duration]');

    // La duración se lee del propio vídeo para que nunca quede desfasada
    const showDuration = () => {
      if (!video || !time || !Number.isFinite(video.duration)) return;
      const total = Math.round(video.duration);
      time.textContent = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
      time.hidden = false;
    };
    video?.addEventListener('loadedmetadata', showDuration);
    // La duración (metadatos) solo se pide cuando el vídeo se acerca a la pantalla
    if (video) {
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          near.disconnect();
          video.preload = 'metadata';
          video.load();
        },
        { rootMargin: '600px 0px' },
      );
      near.observe(video);
    }

    play?.addEventListener('click', () => {
      if (!video) return;
      video.controls = true;
      player.classList.add('is-playing');
      video.play();
      video.focus();
    });
  });
</script>

<style>
  .video__head {
    display: grid;
    justify-items: center;
    gap: 24px;
    margin-bottom: clamp(56px, 7vw, 96px);
    text-align: center;
  }

  .video__lead {
    max-width: 46ch;
    margin: 0;
  }

  .video__stage {
    --p: 1;
    padding-inline: var(--gutter);
  }

  .video__frame {
    max-width: 1440px;
    margin-inline: auto;
    overflow: hidden;
    border-radius: calc(var(--radius-lg) * (1.6 - var(--p)));
    box-shadow: 0 50px 100px -50px rgba(14, 32, 27, 0.55);
    transform: scale(calc(0.72 + 0.28 * var(--p)));
    transform-origin: center top;
    will-change: transform;
  }

  .video__frame :global(.ph) {
    border-radius: 0;
  }

  /* ---------- Panel bajo el vídeo ----------
     Tarjeta de cristal sobre la bruma (como los compromisos de Sobre mí): etiqueta con rombo,
     los tres temas en columnas con filetes finos y, al pie, la descripción desplegable. */
  .vpanel {
    max-width: 1080px;
    margin: clamp(40px, 5vw, 64px) auto 0;
    padding: clamp(24px, 3vw, 36px) clamp(24px, 3.2vw, 44px) 0;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    box-shadow: 0 30px 60px -44px rgba(14, 32, 27, 0.55);
  }

  :global([data-theme='dark']) .vpanel {
    border-color: rgba(131, 129, 130, 0.35);
    background: rgba(0, 0, 0, 0.4);
    box-shadow: none;
  }

  .vpanel__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 clamp(18px, 2vw, 26px);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .vpanel__kicker::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--gold-line);
    transform: rotate(45deg);
  }

  .vpanel__kicker::after {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--gold-line);
  }

  .vpanel__chapters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0 0 clamp(22px, 2.6vw, 30px);
    list-style: none;
  }

  .vpanel__chapters li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 0 clamp(16px, 2vw, 28px);
  }

  .vpanel__chapters li:first-child {
    padding-left: 0;
  }

  .vpanel__chapters li + li {
    border-left: 1px solid var(--line);
  }

  .vpanel__n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--number);
  }

  .vpanel__t {
    font-family: var(--serif);
    font-size: clamp(1.15rem, 1.6vw, 1.375rem);
    font-weight: 300;
    line-height: 1.3;
    color: var(--text);
  }

  /* Pie desplegable: título a la izquierda, «Leer / Ocultar» con el círculo a la derecha */
  .vpanel__alt {
    border-top: 1px solid var(--line);
  }

  .vpanel__alt summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    cursor: pointer;
    list-style: none;
  }

  .vpanel__alt summary::-webkit-details-marker {
    display: none;
  }

  .vpanel__alt summary:focus-visible {
    outline-offset: 4px;
  }

  .vpanel__alt-title {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-style: italic;
    font-weight: 300;
    color: var(--text);
  }

  .vpanel__alt-action {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
  }

  .vpanel__alt-close,
  .vpanel__alt[open] .vpanel__alt-open {
    display: none;
  }

  .vpanel__alt[open] .vpanel__alt-close {
    display: inline;
  }

  .vpanel__alt-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-ui);
    border-radius: 50%;
    color: var(--ink);
    transition:
      transform var(--t-move) var(--ease),
      background-color var(--t-color) var(--ease),
      color var(--t-color) var(--ease);
  }

  .vpanel__alt-icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .vpanel__alt[open] .vpanel__alt-icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--bg);
  }

  .vpanel__alt summary.is-tapped .vpanel__alt-icon {
    background: var(--ink);
    color: var(--bg);
  }

  @media (hover: hover) {
    .vpanel__alt summary:hover .vpanel__alt-icon {
      background: var(--ink);
      color: var(--bg);
    }
  }

  .vpanel__alt-text {
    max-width: 68ch;
    margin: 0;
    padding: 0 0 clamp(24px, 3vw, 32px);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text);
  }

  /* Se despliega y se recoge con suavidad donde el navegador sabe animar <details> */
  @supports (interpolate-size: allow-keywords) {
    .vpanel__alt {
      interpolate-size: allow-keywords;
    }
    .vpanel__alt::details-content {
      height: 0;
      overflow: clip;
      transition:
        height var(--t-move) var(--ease),
        content-visibility var(--t-move) allow-discrete;
    }
    .vpanel__alt[open]::details-content {
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vpanel__alt-icon {
      transition: none;
    }
    .vpanel__alt::details-content {
      transition: none;
    }
  }

  .video__player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--deep);
  }

  .video__player video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Esquinas doradas, como el visor de una cámara */
  .video__corners {
    --c: var(--warm);
    --l: clamp(18px, 2.4vw, 32px);
    position: absolute;
    inset: clamp(14px, 2.2vw, 32px);
    pointer-events: none;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) top left / 1px var(--l),
      linear-gradient(var(--c), var(--c)) top right / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) top right / 1px var(--l),
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) bottom left / 1px var(--l),
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 1px,
      linear-gradient(var(--c), var(--c)) bottom right / 1px var(--l);
    background-repeat: no-repeat;
  }

  /* Pie sobre la imagen, con degradado oscuro para que el texto se lea */
  .video__caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: clamp(48px, 7vw, 96px) clamp(32px, 4.4vw, 64px) clamp(28px, 3.6vw, 52px);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.4) 55%, transparent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #ffffff;
    pointer-events: none;
  }

  /* Botón en píldora: icono + texto visible, más claro que un triángulo solo */
  .video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 8px 26px 8px 8px;
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.55);
    transform: translate(-50%, -50%);
    transition: transform var(--t-move) var(--ease);
  }

  .video__play:hover {
    transform: translate(-50%, -50%) scale(1.04);
  }

  /* El anillo de foco va sobre la foto: un halo del color del botón lo separa de ella para que
     contraste igual sobre zonas claras u oscuras (WCAG 1.4.11) */
  .video__play:focus-visible {
    box-shadow:
      0 0 0 3px var(--surface),
      0 24px 60px -24px rgba(0, 0, 0, 0.55);
  }

  .video__play-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(52px, 5vw, 64px);
    height: clamp(52px, 5vw, 64px);
    border-radius: 50%;
    background: var(--cta-bg);
    color: var(--cta-fg);
  }

  /* Anillo dorado que late suave alrededor del icono, solo al principio */
  .video__play-icon::after {
    content: '';
    position: absolute;
    inset: -6px;
    border: 1px solid var(--gold-line);
    border-radius: 50%;
    animation: video-pulse 2.2s var(--ease) 2 both; /* dos latidos (4,4 s) y se para: WCAG 2.2.2 */
  }

  @keyframes video-pulse {
    0% {
      opacity: 0.9;
      transform: scale(0.92);
    }
    100% {
      opacity: 0;
      transform: scale(1.3);
    }
  }

  .video__play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
  }

  .video__play-text {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .video__play-time {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .video__play-time::before {
    content: '·';
    margin-right: 10px;
  }

  .video__player.is-playing .video__corners,
  .video__player.is-playing .video__caption,
  .video__player.is-playing .video__play {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .video__play,
    .video__play:hover {
      transition: none;
      transform: translate(-50%, -50%);
    }
    .video__play-icon::after {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    /* En móvil el marco es pequeño: sin pie y con un botón más compacto */
    .video__caption {
      display: none;
    }
    .video__play {
      gap: 10px;
      padding: 5px 16px 5px 5px;
      font-size: 0.875rem;
    }
    .video__play-icon {
      width: 44px;
      height: 44px;
    }
    .video__play svg {
      width: 18px;
      height: 18px;
    }
    /* Móvil: los tres temas en lista, separados por filetes */
    .vpanel__chapters {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 8px;
    }
    .vpanel__chapters li,
    .vpanel__chapters li:first-child {
      grid-template-columns: 32px 1fr;
      align-items: baseline;
      padding: 14px 0;
    }
    .vpanel__chapters li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
